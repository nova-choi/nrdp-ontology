### 정규화방법 / 선호함수 / 집계기법 / 정규화 활동
ex:NM_MinMax a mcdm:NormalizationMethod ; rdfs:label "min-max 정규화"@ko ; mcdm:normalizedLowerBound "0"^^xsd:decimal ; mcdm:normalizedUpperBound "1"^^xsd:decimal .
ex:NM_Vector a mcdm:NormalizationMethod ; rdfs:label "벡터 정규화"@ko .
ex:PF_VShape a mcdm:PreferenceFunction ; rdfs:label "V-shape 선호함수"@ko ; mcdm:preferenceThresholdQ "0.0"^^xsd:decimal ; mcdm:preferenceThresholdP "0.5"^^xsd:decimal .
ex:ACT_NORM_MinMax a mcdm:NormalizationActivity ; rdfs:label "min-max 정규화 수행 (완전평가 대안 집합 기준)"@ko ; prov:used ex:NM_MinMax .
ex:ACT_NORM_Vector a mcdm:NormalizationActivity ; rdfs:label "벡터 정규화 수행 (완전평가 대안 집합 기준)"@ko ; prov:used ex:NM_Vector .
ex:M_WSM a mcdm:ValueFunctionMethod ; rdfs:label "가중합법(WSM)"@ko ; mcdm:hasCompensationLevel mcdm:FullCompensation ; mcdm:requiresNormalization "true"^^xsd:boolean ; mcdm:supportsAdditiveDecomposition "true"^^xsd:boolean ; mcdm:usesNormalization ex:NM_MinMax .
ex:M_TOPSIS a mcdm:DistanceBasedMethod ; rdfs:label "TOPSIS"@ko ; mcdm:hasCompensationLevel mcdm:FullCompensation ; mcdm:requiresNormalization "true"^^xsd:boolean ; mcdm:supportsAdditiveDecomposition "false"^^xsd:boolean ; mcdm:usesNormalization ex:NM_Vector .
