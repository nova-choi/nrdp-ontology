ex:C_PATREG a mcdm:LeafCriterion , mcdm:BenefitCriterion ; rdfs:label "등록특허 연평균"@ko ; mcdm:hasDirection mcdm:Benefit ; mcdm:hasScale mcdm:RatioScale ; mcdm:measuredBy ex:IND_W_PATREG .
ex:C_EFF a mcdm:CompositeCriterion ; rdfs:label "투자 효율"@ko .
ex:C_SCI_EFF a mcdm:LeafCriterion , mcdm:BenefitCriterion ; rdfs:label "연구비 1억원당 SCI 논문"@ko ; mcdm:hasDirection mcdm:Benefit ; mcdm:hasScale mcdm:RatioScale ; mcdm:measuredBy ex:IND_W_SCI_EFF .
