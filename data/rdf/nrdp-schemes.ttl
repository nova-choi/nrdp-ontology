    skos:prefLabel "특허 등록"@ko ;
    rdfs:label "특허 등록"@ko ;
    skos:broader ex:OT_PATENT .

### 금액 산정기준 / 집계 규칙
ex:CS_AMOUNTBASIS a skos:ConceptScheme ;
    rdfs:label "예산배분 금액 산정기준"@ko .
ex:AB_CONTRACT_SUM a skos:Concept ;
    skos:inScheme ex:CS_AMOUNTBASIS ;
    skos:prefLabel "과제 협약 정부연구비 합산(과제연도기록 GovernmentFunds 합)"@ko ;
    rdfs:label "과제 협약 정부연구비 합산(과제연도기록 GovernmentFunds 합)"@ko .
ex:CS_ROLLUPRULE a skos:ConceptScheme ;
    rdfs:label "사업 단위 집계 규칙"@ko .
ex:RR_R1 a skos:Concept ;
    skos:inScheme ex:CS_ROLLUPRULE ;
    skos:prefLabel "R1 단위: 정본 사업 × 과제 기준연도. 별칭(표기 변형) 기록은 정본으로 합산"@ko ;
    rdfs:label "R1 단위: 정본 사업 × 과제 기준연도. 별칭(표기 변형) 기록은 정본으로 합산"@ko .
ex:RR_R2 a skos:Concept ;
    skos:inScheme ex:CS_ROLLUPRULE ;
    skos:prefLabel "R2 연구비: 과제연도기록 정부연구비(GovernmentFunds) 합"@ko ;
    rdfs:label "R2 연구비: 과제연도기록 정부연구비(GovernmentFunds) 합"@ko .
ex:RR_R3 a skos:Concept ;
    skos:inScheme ex:CS_ROLLUPRULE ;
    skos:prefLabel "R3 성과 귀속: 성과의 (과제고유번호, 기준연도)가 가리키는 과제연도기록의 사업·연도로 귀속, 성과 ID 기준 사업 내 중복 제거"@ko ;
    rdfs:label "R3 성과 귀속: 성과의 (과제고유번호, 기준연도)가 가리키는 과제연도기록의 사업·연도로 귀속, 성과 ID 기준 사업 내 중복 제거"@ko .
ex:RR_R4 a skos:Concept ;
    skos:inScheme ex:CS_ROLLUPRULE ;
    skos:prefLabel "R4 성과 시차: 과제연도 t 의 성과는 등록연도 t·t+1 분만 집계, 누적값은 별도 지표"@ko ;
    rdfs:label "R4 성과 시차: 과제연도 t 의 성과는 등록연도 t·t+1 분만 집계, 누적값은 별도 지표"@ko .
ex:RR_R5 a skos:Concept ;
    skos:inScheme ex:CS_ROLLUPRULE ;
    skos:prefLabel "R5 연속과제 추적(trace)으로만 수집된 기록은 정본 사업이 없어 집계 제외"@ko ;
    rdfs:label "R5 연속과제 추적(trace)으로만 수집된 기록은 정본 사업이 없어 집계 제외"@ko .
ex:RR_R6 a skos:Concept ;
    skos:inScheme ex:CS_ROLLUPRULE ;
    skos:prefLabel "R6 기여율은 공개 API 미제공 — 전량 귀속(contributionShare 비움)"@ko ;
    rdfs:label "R6 기여율은 공개 API 미제공 — 전량 귀속(contributionShare 비움)"@ko .
ex:RR_R7 a skos:Concept ;
    skos:inScheme ex:CS_ROLLUPRULE ;
    skos:prefLabel "R7 평가 창: 창 안 존속 연도 연평균, 효율 지표는 창 합계 성과/창 합계 연구비"@ko ;
    rdfs:label "R7 평가 창: 창 안 존속 연도 연평균, 효율 지표는 창 합계 성과/창 합계 연구비"@ko .
ex:RR_R8 a skos:Concept ;
    skos:inScheme ex:CS_ROLLUPRULE ;
    skos:prefLabel "R8 별칭: 판정 규칙 + alias_overrides.csv 수작업 판정으로 채택된 이름만 정본으로 합산"@ko ;
    rdfs:label "R8 별칭: 판정 규칙 + alias_overrides.csv 수작업 판정으로 채택된 이름만 정본으로 합산"@ko .
ex:RR_FIELD a skos:Concept ;
    skos:inScheme ex:CS_ROLLUPRULE ;
    skos:prefLabel "사업 분야(belongsToField): 과제연도기록 1순위 표준분류 대분류의 최빈값"@ko ;
    rdfs:label "사업 분야(belongsToField): 과제연도기록 1순위 표준분류 대분류의 최빈값"@ko .

### 국가전략기술 (12대, 2022.10 발표 · 2023년 과제정보 입력분부터 태깅) — 대상 사업 선정 축
ex:KOS_NST a kosv:Classification ;
    rdfs:label "국가전략기술 분류"@ko .
ex:NST_2023 a kosv:ClassificationEdition ;
    kosv:editionOf ex:KOS_NST ;
    kosv:announcedYear "2022"^^xsd:integer ;
    kosv:validFromYear "2023"^^xsd:integer ;
    rdfs:label "국가전략기술 12대 분야 (2023년 입력분 적용)"@ko .
