          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/nrdp/ontology#GoalAlignment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "사업→정책목표 연결은 법정 원천이 없는 연구자 부여 매핑이므로 근거(evidence)와 주체(prov:wasAttributedTo)를 갖는 개체로 재화한다(추적표 F2)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "정책목표 연결"
      },
      {
        "@language": "en",
        "@value": "Goal alignment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      },
      {
        "@id": "_:nbba563a96a4941a689fa30cabe39574eb61"
      },
      {
        "@id": "_:nbba563a96a4941a689fa30cabe39574eb62"
      }
    ]
  },
  {
