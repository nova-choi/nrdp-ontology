    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "org:originalOrganization / org:resultingOrganization 으로 개편 전후 부처를 잇는다. 예: 미래창조과학부 → 과학기술정보통신부(2017)."
      }
    ],
