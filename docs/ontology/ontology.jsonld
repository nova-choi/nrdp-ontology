  {
    "@id": "https://w3id.org/nrdp/ontology#TechnologyField",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "개념은 판별(kosv:ClassificationEdition) 개념으로 둔다. 코드가 같아도 판이 다르면 별개 IRI이며, 판 간 연결은 대응표(xkos:Correspondence)로만 표현한다. 판 내부의 계층은 코드 접두(대·중분류)로 skos:broader 를 부여한다. 2023판 고시본의 세부영역 코드도 중분류 접두를 유지하므로 계층 부여에 문제가 없다."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "기술분야(국가과학기술표준분류)"
      },
      {
        "@language": "en",
        "@value": "Technology field"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      },
      {
        "@id": "_:nbba563a96a4941a689fa30cabe39574eb16"
      }
    ]
  },
  {
