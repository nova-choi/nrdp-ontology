        "@id": "https://w3id.org/nrdp/kosv#ClassificationEdition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/nrdp/ontology#jointPerformer",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "법정 서식 항목. 공개 API 미제공 — 원자료 확보 시에만 인스턴스화."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/nrdp/ontology#ProjectYearRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "공동연구개발기관"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/nrdp/ontology#PerformingOrganization"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/nrdp/ontology#performedBy"
      }
    ]
  },
  {
    "@id": "https://w3id.org/nrdp/ontology",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "최혜석"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "ko",
        "@value": "국가연구개발혁신법 시행규칙 서식과 국가과학기술표준분류 등 국내 법정·고시 기준에서 도출한 국가 R&D 포트폴리오 도메인 계층(사업·과제·부처·전문기관·수행기관·기술분야·예산·성과). CERIF 1.6.1과 정렬하였다."
      },
      {
        "@language": "en",
        "@value": "Domain layer for the Korean national R&D portfolio (programmes, projects, ministries, funding agencies, performers, technology fields, budgets, outputs), derived from Korean statutory forms and classification notices and aligned with CERIF 1.6.1."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-10-31"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "National R&D portfolio domain ontology"
      },
      {
        "@language": "ko",
        "@value": "국가 R&D 포트폴리오 도메인 온톨로지"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "nrdp"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://w3id.org/nrdp/ontology#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "v0.3.5: 공개용 메타데이터(설명, 수정일, 선호 접두어·네임스페이스) 추가. 논리 공리는 v0.3.4와 동일."
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "https://w3id.org/nrdp/mcdm"
      },
      {
        "@id": "https://w3id.org/nrdp/kosv"
      }
    ],
    "http://www.w3.org/2002/07/owl#priorVersion": [
      {
        "@id": "https://w3id.org/nrdp/ontology/0.3.4"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/nrdp/ontology/0.3.5"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.3.5"
      }
    ]
  },
  {
    "@id": "https://w3id.org/nrdp/ontology#recordedProgramName",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "원천 레코드에 기재된 사업명 문자열(감사 추적용). 정규화된 사업 개체는 partOfProgram/ofProgram 으로 연결."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/nrdp/ontology#ProjectYearRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "원천 표기 사업명"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/nrdp/ontology#RollupActivity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "과제연도기록을 세부사업×연도 값으로 집계하는 활동. MCDM 집계기법(mcdm:AggregationMethod)과 구별하기 위해 '롤업'으로 명명."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "사업 단위 집계"
      },
      {
        "@language": "en",
        "@value": "Program-level rollup"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/nrdp/ontology#partOfProgram",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#IrreflexiveProperty",
      "http://www.w3.org/2002/07/owl#AsymmetricProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "과제연도기록→내역사업→세부사업의 직접 소속. 과제의 소속 사업은 연도별로 달라질 수 있어 과제가 아닌 과제연도기록에서 출발한다. v0.3.3에서 추이적 선언 대신 비반사·비대칭으로 선언하고 전이 폐쇄는 질의로 처리한다(OOPS! P29, T1과 같은 원칙)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "_:nbba563a96a4941a689fa30cabe39574eb4"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "상위사업"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "_:nbba563a96a4941a689fa30cabe39574eb7"
      }
    ]
  },
