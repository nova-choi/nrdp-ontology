  },
  {
    "@id": "https://w3id.org/nrdp/ontology#RnDProject",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "협약 단위의 다년 과제. NTIS는 과제를 연도별 레코드(과제고유번호)로 분할하므로, 연도별 정보는 ProjectYearRecord 가 보유한다."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "연구개발과제"
      },
      {
        "@language": "en",
        "@value": "R&D project"
      }
    ]
  },
  {
    "@id": "https://w3id.org/nrdp/ontology#outputId",
