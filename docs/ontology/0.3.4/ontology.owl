>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#Ministry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nrdp/ontology#Organization"/>
    <rdfs:label xml:lang="ko">중앙행정기관</rdfs:label>
    <rdfs:label xml:lang="en">Ministry</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b6">
    <rdf:first rdf:resource="https://w3id.org/nrdp/ontology#RnDSubProgram"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#jointPerformer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/nrdp/ontology#performedBy"/>
    <rdfs:label xml:lang="ko">공동연구개발기관</rdfs:label>
    <rdfs:comment xml:lang="ko">법정 서식 항목. 공개 API 미제공 — 원자료 확보 시에만 인스턴스화.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#ProjectYearRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/ontology#PerformingOrganization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#isSCI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">SCI 여부</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#ResearchOutput"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#SourceRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="ko">원천 레코드</rdfs:label>
    <rdfs:label xml:lang="en">Source record</rdfs:label>
    <rdfs:comment xml:lang="ko">스냅샷 안의 개별 원본 레코드(API 응답 HIT 1건 등). prov:hadPrimarySource 로 스냅샷에 연결.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#harmonizationWeight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">판 맞춤 배분 비중</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#FieldAssignment"/>
    <rdfs:range rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b34"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b37">
    <rdf:first rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b35"/>
    <rdf:rest rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b38"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#IndicatorObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b58"/>
    <rdfs:subClassOf rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b59"/>
    <rdfs:subClassOf rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b60"/>
    <rdfs:label xml:lang="ko">성과관측치</rdfs:label>
    <rdfs:label xml:lang="en">Indicator observation</rdfs:label>
    <rdfs:comment xml:lang="ko">세부사업×연도×지표×값의 재화. 과제 단위 원천을 RollupActivity 로 집계한 파생값이다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#outputId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">성과 ID(NTIS)</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#ResearchOutput"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#assignmentShare">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">비중(%)</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#FieldAssignment"/>
    <rdfs:range rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b25"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#strategicTechnology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">국가전략기술(사업 수준)</rdfs:label>
    <rdfs:label xml:lang="en">National strategic technology (program level)</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#RnDProgram"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:comment xml:lang="ko">v0.3.1 (2026-10-19) 추가. D1 (c)에 따라 분석 대상 세부사업을 선정한 축. 값은 국가전략기술 12대 분야 판(kosv:ClassificationEdition, 2023년 입력분 적용)의 개념이며, 2023년 과제정보의 국가전략기술 패싯에서 가장 큰 비중을 차지한 분야를 사업에 부여한 파생값이다(ntis_collect.py candidates 단계). 과제 수준의 원천 값은 policyTechnologyClass 로 보존한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#ntisProjectId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">과제고유번호(NTIS)</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#ProjectYearRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#PerformanceIndicator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nrdp/mcdm#Indicator"/>
    <rdfs:label xml:lang="ko">성과지표</rdfs:label>
    <rdfs:label xml:lang="en">Performance indicator</rdfs:label>
    <rdfs:comment xml:lang="ko">도메인 지표. mcdm:Indicator 의 하위클래스로 선언하여 MCDM 계층이 도메인 계층을 참조하지 않게 한다(T10).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/ontology#ofProject"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/nrdp/ontology#RnDProject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#queryCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">질의 조건</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#CollectionActivity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#OutputAttribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">성과 귀속</rdfs:label>
    <rdfs:label xml:lang="en">Output attribution</rdfs:label>
    <rdfs:comment xml:lang="ko">성과물×과제연도기록(×기여율)의 재화. 한 성과물이 복수 과제에 귀속될 수 있어, 사업 단위 집계 시 성과 ID 기준 중복 제거 규칙의 근거가 된다. 기여율은 법정 서식 항목이나 공개 API 미제공 — 선택 항목.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b51"/>
    <rdfs:subClassOf rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b52"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#continuationStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">신규·계속 구분</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#ProjectYearRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:comment xml:lang="ko">NTIS ContinuousFlag. 코드값 의미는 API 승인 후 확인(B1).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#alignmentEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">연결 근거</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#GoalAlignment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#commissionedPerformer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/nrdp/ontology#performedBy"/>
    <rdfs:label xml:lang="ko">위탁연구개발기관</rdfs:label>
    <rdfs:comment xml:lang="ko">법정 서식 항목. 공개 API 미제공.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#ProjectYearRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/ontology#PerformingOrganization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#RnDProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">연구개발과제</rdfs:label>
    <rdfs:label xml:lang="en">R&amp;D project</rdfs:label>
    <rdfs:comment xml:lang="ko">협약 단위의 다년 과제. NTIS는 과제를 연도별 레코드(과제고유번호)로 분할하므로, 연도별 정보는 ProjectYearRecord 가 보유한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#ProjectYearRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b1"/>
    <rdfs:subClassOf rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b2"/>
    <rdfs:subClassOf rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b3"/>
    <rdfs:label xml:lang="ko">과제연도기록</rdfs:label>
    <rdfs:label xml:lang="en">Project-year record</rdfs:label>
    <rdfs:comment xml:lang="ko">과제×회계연도 재화(n-ary). NTIS 과제고유번호 1건에 대응. 연구비·분류·수행기관·소속 사업이 연도별로 달라질 수 있어 과제가 아닌 이 단위에 귀속한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#contributesTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">기여정책목표</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#RnDProgram"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/ontology#PolicyGoal"/>
    <owl:propertyChainAxiom rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b64"/>
    <rdfs:comment xml:lang="ko">GoalAlignment 를 거치는 속성 사슬로 정의되는 단축 속성. 추론 시 GoalAlignment 로부터 도출된다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#totalFunds">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">총연구비(원)</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#ProjectYearRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b23">
    <rdf:first rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b21"/>
    <rdf:rest rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b24"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#policyTechnologyClass">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">정책기술분류</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#ProjectYearRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:comment xml:lang="ko">조사·분석 과제정보의 정책기술 항목. 2022년 입력분까지는 중점과학기술(11대·43중·120개), 2023년 입력분부터는 국가전략기술(12대·50개 세부)로 대체되었다(2022년도 조사분석 실시계획). 두 체계는 별개 분류(kosv:Classification)의 판이며, 원천 값은 각 판의 개념으로 보존한다. 공식 대응표가 없으므로 두 체계 사이의 대응은 두지 않는다(D1 (c): 분석 대상 사업은 2023년 국가전략기술 태그로 선정하고, 이전 연도 이력은 ProgramIdentityResolution 으로 추적).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b47">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b48"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#Activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#ofProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">소속 과제</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#ProjectYearRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/ontology#RnDProject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b46">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/ontology#amountBasis"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#applicationArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">적용분야</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#ProjectYearRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#PolicyGoal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="ko">정책목표</rdfs:label>
    <rdfs:label xml:lang="en">Policy goal</rdfs:label>
    <rdfs:comment xml:lang="ko">과학기술기본계획 목표. 차수(3차 2013–17, 4차 2018–22, 5차 2023–27)별 ConceptScheme에 속한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#performedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">수행기관</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#ProjectYearRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/ontology#PerformingOrganization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#yearValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/ontology#FiscalYear"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="ko">xsd:gYear 는 OWL 2 datatype map 밖이라 xsd:integer 사용.</rdfs:comment>
    <rdfs:label xml:lang="ko">연도 값</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b67">
    <rdf:first rdf:resource="https://w3id.org/nrdp/ontology#RollupActivity"/>
    <rdf:rest rdf:nodeID="n0184b59e9c524ac9bb403f1c7b25b5a5b68"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#annualPeriodStart">
