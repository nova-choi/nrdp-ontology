<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#Ministry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nrdp/ontology#Organization"/>
    <rdfs:label xml:lang="ko">중앙행정기관</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasDirection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#Criterion"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#OptimizationDirection"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasContributionRatio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CriterionContribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#isFeasible">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CounterfactualCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="ko">실현가능성</rdfs:label>
    <rdfs:comment xml:lang="ko">요구 개선량이 관측 범위 내인지. 정규화값 1.0 초과 시 false.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#IndicatorObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">성과관측치</rdfs:label>
    <rdfs:comment xml:lang="ko">사업×연도×지표×값의 4항 관계를 재화한 클래스.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#explains">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#Explanation"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#DecisionResult"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#EvidencePath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nrdp/mcdm#Explanation"/>
    <rdfs:label xml:lang="ko">근거경로</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="ko">국가 R&amp;D 포트폴리오 MCDM 온톨로지</dcterms:title>
    <dcterms:creator>최혜석</dcterms:creator>
    <owl:versionInfo>0.2.1</owl:versionInfo>
    <rdfs:comment xml:lang="ko">국가 R&amp;D 포트폴리오 평가를 위한 방법 중립적 MCDM 온톨로지. v0.2: 정규화값을 (평가값×정규화방법) 3항 관계로 재화.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#Weight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">가중치</rdfs:label>
    <rdfs:comment xml:lang="ko">기준의 고유 속성이 아니라 시나리오에 종속되는 개체.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#BudgetAllocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">예산배분</rdfs:label>
    <rdfs:comment xml:lang="ko">사업×연도×금액의 3항 관계를 재화한 클래스.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n34603c80aa6f46d98abd8918571e9216b1"/>
    <rdfs:subClassOf rdf:nodeID="n34603c80aa6f46d98abd8918571e9216b2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#requiredNormalizedValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CounterfactualCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">필요 정규화값</rdfs:label>
    <rdfs:comment xml:lang="ko">목표 순위 진입에 필요한 해당 기준의 정규화값. 1.0을 넘으면 관측 범위 밖이므로 isFeasible=false.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#CriterionValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">평가값</rdfs:label>
    <rdfs:comment xml:lang="ko">대안×기준의 원시 평가값. n-ary 재화. v0.2부터 정규화값은 별도 보유하지 않고 hasNormalization으로 NormalizedValue를 참조.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n34603c80aa6f46d98abd8918571e9216b6"/>
    <rdfs:subClassOf rdf:nodeID="n34603c80aa6f46d98abd8918571e9216b7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#Criterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">평가기준</rdfs:label>
    <owl:equivalentClass rdf:nodeID="n34603c80aa6f46d98abd8918571e9216b3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasPreferenceModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#AggregationMethod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasNormalization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CriterionValue"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#NormalizedValue"/>
    <rdfs:label xml:lang="ko">정규화값 보유</rdfs:label>
    <rdfs:comment xml:lang="ko">v0.2 신설. 하나의 CriterionValue는 정규화방법 수만큼(1..*) NormalizedValue를 가질 수 있다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#PreferenceFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">선호함수</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#ofCriterionValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#NormalizedValue"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#CriterionValue"/>
    <owl:inverseOf rdf:resource="https://w3id.org/nrdp/mcdm#hasNormalization"/>
    <rdfs:label xml:lang="ko">원평가값</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#preferenceThresholdP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#PreferenceFunction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#TechnologyField">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="ko">기술분야</rdfs:label>
    <rdfs:comment xml:lang="ko">국가과학기술표준분류체계(과기정통부 고시) 기반.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/ontology#belongsToField">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/ontology#TechnologyField"/>
    <rdfs:label xml:lang="ko">기술분야</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CriterionValue"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasScore">
