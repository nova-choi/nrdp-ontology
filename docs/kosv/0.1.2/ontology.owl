>
  <rdf:Description rdf:about="http://rdf-vocabulary.ddialliance.org/xkos#follows">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:label xml:lang="ko">계승</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/kosv#ClassificationEdition"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/kosv#ClassificationEdition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#HarmonizationActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:subClassOf rdf:nodeID="nbd47128ea9054950b698511951cb5991b39"/>
    <rdfs:label xml:lang="ko">판 맞춤</rdfs:label>
    <rdfs:label xml:lang="en">Harmonization run</rdfs:label>
    <rdfs:comment xml:lang="ko">원래 판의 분류값을 특정 대응표(prov:used)로 다른 판에 맞춘 값을 생성하는 활동. 생성된 값은 prov:wasDerivedFrom 으로 원래 값을 가리킨다. 원래 값은 덮어쓰지 않는다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbd47128ea9054950b698511951cb5991b31">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/kosv#shareOf"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#ConceptAssociation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#editionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#belongsTo"/>
    <rdfs:label xml:lang="ko">소속 분류체계</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/kosv#ClassificationEdition"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/kosv#Classification"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbd47128ea9054950b698511951cb5991b7">
    <rdf:first rdf:resource="https://w3id.org/nrdp/kosv#Merge"/>
    <rdf:rest rdf:nodeID="nbd47128ea9054950b698511951cb5991b8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#Identity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/nrdp/kosv#ChangeType"/>
    <rdfs:label xml:lang="ko">동일</rdfs:label>
    <rdfs:comment xml:lang="ko">코드·명칭 동일. 1:1.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbd47128ea9054950b698511951cb5991b29">
    <rdf:first rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#Correspondence"/>
    <rdf:rest rdf:nodeID="nbd47128ea9054950b698511951cb5991b30"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf-vocabulary.ddialliance.org/xkos#Correspondence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">대응표</rdfs:label>
    <rdfs:label xml:lang="en">Correspondence</rdfs:label>
    <rdfs:comment xml:lang="ko">두 판 사이의 개념 연관 집합.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nbd47128ea9054950b698511951cb5991b1"/>
    <rdfs:subClassOf rdf:nodeID="nbd47128ea9054950b698511951cb5991b2"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbd47128ea9054950b698511951cb5991b2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/kosv#correspondenceBasis"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/nrdp/kosv#CorrespondenceBasis"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#Split">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/nrdp/kosv#ChangeType"/>
    <rdfs:label xml:lang="ko">분할</rdfs:label>
    <rdfs:comment xml:lang="ko">1:N. 집계 시 배분 규칙 필요.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#changeType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">변경 유형</rdfs:label>
    <rdfs:domain rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#ConceptAssociation"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/kosv#ChangeType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#fromConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/kosv#AllocationShare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="ko">배분 원천 개념</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#discontinuedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">종료 판</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/kosv#ClassificationEdition"/>
    <rdfs:comment xml:lang="ko">후속 판에서 대상 개념이 없는 개념. 대비표의 '삭제' 표기는 실제로는 다른 중분류로의 이동·통합인 경우가 있으므로(예: 2018판 EE08·EE09 → 2023판 EE1207·EE1208), 검토 후에만 부여한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#AllocationShare">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">배분 비중</rdfs:label>
    <rdfs:label xml:lang="en">Allocation share</rdfs:label>
    <rdfs:comment xml:lang="ko">분할·통합 후 재분할 연관에서 (원천, 대상) 쌍별 배분 비중. 집계값이 이 비중에 의존하므로 근거를 함께 기록한다. 같은 원천의 비중 합 = 1 은 SHACL로 검사.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nbd47128ea9054950b698511951cb5991b31"/>
    <rdfs:subClassOf rdf:nodeID="nbd47128ea9054950b698511951cb5991b32"/>
    <rdfs:subClassOf rdf:nodeID="nbd47128ea9054950b698511951cb5991b33"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#toConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/kosv#AllocationShare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="ko">배분 대상 개념</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#correspondenceBasis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">대응 근거</rdfs:label>
    <rdfs:domain rdf:nodeID="nbd47128ea9054950b698511951cb5991b28"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/kosv#CorrespondenceBasis"/>
    <rdfs:comment xml:lang="ko">대응표 단위로 부여하되, 같은 대응표 안에서 근거가 다른 연관(공식 대비표 + 규칙 도출)은 연관 단위로 덮어쓴다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#Classification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">분류체계</rdfs:label>
    <rdfs:label xml:lang="en">Classification</rdfs:label>
    <rdfs:comment xml:lang="ko">판을 묶는 분류체계 자체(예: 국가과학기술표준분류). XKOS는 이를 skos:Concept 로 모델링하도록 권고하나, 여기서는 판(ConceptScheme)과 구분되는 별도 클래스로 둔다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#Activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#Relocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/nrdp/kosv#ChangeType"/>
    <rdfs:label xml:lang="ko">이동</rdfs:label>
    <rdfs:comment xml:lang="ko">다른 중분류로 이동하며 코드 변경. 1:1 또는 통합과 결합.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbd47128ea9054950b698511951cb5991b30">
    <rdf:first rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#ConceptAssociation"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#sourceLocator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">근거 위치</rdfs:label>
    <rdfs:domain rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#ConceptAssociation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="ko">근거 문서 내 위치(쪽·행). 감사 추적용.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#RuleDerived">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/nrdp/kosv#CorrespondenceBasis"/>
    <rdfs:label xml:lang="ko">규칙 도출</rdfs:label>
    <rdfs:comment xml:lang="ko">명시적 규칙에서 도출(예: 대비표에 수록되지 않은 중분류는 코드 동일 개념끼리 1:1).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#CorrespondenceBasis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">대응 근거</rdfs:label>
    <rdfs:label xml:lang="en">Correspondence basis</rdfs:label>
    <owl:equivalentClass rdf:nodeID="nbd47128ea9054950b698511951cb5991b18"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbd47128ea9054950b698511951cb5991b22">
    <rdf:first rdf:resource="https://w3id.org/nrdp/kosv#DataDerived"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf-vocabulary.ddialliance.org/xkos#ConceptAssociation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">개념 연관</rdfs:label>
    <rdfs:label xml:lang="en">Concept association</rdfs:label>
    <rdfs:comment xml:lang="ko">원천 개념 n개와 대상 개념 m개의 연관(n:m을 한 개체로 표현). 원천·대상 개수와 변경 유형의 정합성은 폐쇄세계 검사이므로 SHACL(kosv-shapes.ttl)로 위임한다.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nbd47128ea9054950b698511951cb5991b3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#ChangeType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">변경 유형</rdfs:label>
    <rdfs:label xml:lang="en">Change type</rdfs:label>
    <owl:equivalentClass rdf:nodeID="nbd47128ea9054950b698511951cb5991b4"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbd47128ea9054950b698511951cb5991b16">
    <rdf:first rdf:resource="https://w3id.org/nrdp/kosv#MergeResplit"/>
    <rdf:rest rdf:nodeID="nbd47128ea9054950b698511951cb5991b17"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#shareValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">비중</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/kosv#AllocationShare"/>
    <rdfs:range rdf:nodeID="nbd47128ea9054950b698511951cb5991b34"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#targetEdition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#compares"/>
    <rdfs:label xml:lang="ko">이후 판</rdfs:label>
    <rdfs:domain rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#Correspondence"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/kosv#ClassificationEdition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">Classification edition and correspondence module</dcterms:title>
    <dcterms:title xml:lang="ko">분류체계 판 관리·대응표 모듈</dcterms:title>
    <dcterms:creator>최혜석</dcterms:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <owl:versionIRI rdf:resource="https://w3id.org/nrdp/kosv/0.1.2"/>
    <dcterms:description xml:lang="ko">분류체계의 판(edition)과 판 사이 대응표를 표현하는 모듈. 국가과학기술표준분류 2018·2023 개정판처럼 기간 중 바뀌는 분류를 판별 개념으로 보존하고 대응 관계를 기록한다.</dcterms:description>
    <dcterms:description xml:lang="en">Module for classification editions and inter-edition correspondences (XKOS-based), used to keep technology-field codes of different classification editions apart.</dcterms:description>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-31</dcterms:modified>
    <vann:preferredNamespacePrefix>kosv</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/nrdp/kosv#</vann:preferredNamespaceUri>
    <owl:versionInfo>0.1.2</owl:versionInfo>
    <owl:priorVersion rdf:resource="https://w3id.org/nrdp/kosv/0.1.1"/>
    <rdfs:comment xml:lang="ko">v0.1.2: 공개용 메타데이터(설명, 수정일, 선호 접두어·네임스페이스) 추가. 논리 공리는 v0.1.1와 동일.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdf-vocabulary.ddialliance.org/xkos#belongsTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
