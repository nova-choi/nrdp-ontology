  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#DataDerived">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/nrdp/kosv#CorrespondenceBasis"/>
    <rdfs:label xml:lang="ko">데이터 도출</rdfs:label>
    <rdfs:comment xml:lang="ko">동일 과제의 이중 코딩(구·신 분류 병기) 빈도에서 추정.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbd47128ea9054950b698511951cb5991b6">
