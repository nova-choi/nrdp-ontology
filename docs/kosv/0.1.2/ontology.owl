  <rdf:Description rdf:about="https://w3id.org/nrdp/kosv#introducedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">도입 판</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/kosv#ClassificationEdition"/>
