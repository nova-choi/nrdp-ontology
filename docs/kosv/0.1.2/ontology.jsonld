        "@type": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger",
        "@value": "1"
      }
    ]
  },
  {
    "@id": "https://w3id.org/nrdp/kosv#ClassificationEdition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "분류체계의 한 개정판. 유효기간은 연도 정수로 기록(xsd:gYear 는 OWL 2 datatype map 밖). XKOS 권고에 따라 dcterms:valid 를 주석으로 병기할 수 있다."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "분류체계 판"
      },
      {
        "@language": "en",
        "@value": "Classification edition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#ConceptScheme"
      }
    ]
  },
