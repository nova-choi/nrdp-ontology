  {
    "@id": "https://w3id.org/nrdp/kosv",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "최혜석"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "ko",
        "@value": "분류체계의 판(edition)과 판 사이 대응표를 표현하는 모듈. 국가과학기술표준분류 2018·2023 개정판처럼 기간 중 바뀌는 분류를 판별 개념으로 보존하고 대응 관계를 기록한다."
      },
      {
        "@language": "en",
        "@value": "Module for classification editions and inter-edition correspondences (XKOS-based), used to keep technology-field codes of different classification editions apart."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-10-31"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "Classification edition and correspondence module"
      },
      {
        "@language": "ko",
        "@value": "분류체계 판 관리·대응표 모듈"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "kosv"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://w3id.org/nrdp/kosv#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "v0.1.2: 공개용 메타데이터(설명, 수정일, 선호 접두어·네임스페이스) 추가. 논리 공리는 v0.1.1와 동일."
      }
    ],
    "http://www.w3.org/2002/07/owl#priorVersion": [
      {
        "@id": "https://w3id.org/nrdp/kosv/0.1.1"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/nrdp/kosv/0.1.2"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.1.2"
      }
    ]
  },
  {
    "@id": "https://w3id.org/nrdp/kosv#discontinuedIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "후속 판에서 대상 개념이 없는 개념. 대비표의 '삭제' 표기는 실제로는 다른 중분류로의 이동·통합인 경우가 있으므로(예: 2018판 EE08·EE09 → 2023판 EE1207·EE1208), 검토 후에만 부여한다."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ],
