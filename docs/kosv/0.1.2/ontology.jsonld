  {
    "@id": "http://rdf-vocabulary.ddialliance.org/xkos#ConceptAssociation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "원천 개념 n개와 대상 개념 m개의 연관(n:m을 한 개체로 표현). 원천·대상 개수와 변경 유형의 정합성은 폐쇄세계 검사이므로 SHACL(kosv-shapes.ttl)로 위임한다."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "개념 연관"
      },
      {
        "@language": "en",
        "@value": "Concept association"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:nbd47128ea9054950b698511951cb5991b3"
      }
    ]
  },
  {
    "@id": "_:nbd47128ea9054950b698511951cb5991b3",
