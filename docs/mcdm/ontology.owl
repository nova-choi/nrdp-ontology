    <rdfs:label xml:lang="ko">정규화방법</rdfs:label>
    <rdfs:label xml:lang="en">Normalization method</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasRank">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#DecisionResult"/>
    <rdfs:range rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b64"/>
    <rdfs:label xml:lang="ko">순위</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#preferenceThresholdQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">무차별 임계값 q</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#PreferenceFunction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#concernsCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">개선 대상 기준</rdfs:label>
    <rdfs:label xml:lang="en">concerns criterion</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CounterfactualCondition"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#Criterion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b66">
    <rdf:first rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b65"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#DecisionResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b60"/>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b61"/>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b62"/>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b63"/>
    <rdfs:label xml:lang="ko">평가결과</rdfs:label>
    <rdfs:label xml:lang="en">Decision result</rdfs:label>
    <rdfs:comment xml:lang="ko">(문제, 시나리오, 기법, 대안) 조합의 산출. 한 (시나리오, 기법) 안의 순위가 1..n 순열이라는 제약은 SHACL-SPARQL로 위임.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b55">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#requiresNormalization"/>
    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#BenefitCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">편익형 기준</rdfs:label>
    <rdfs:label xml:lang="en">Benefit criterion</rdfs:label>
    <owl:equivalentClass rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b8"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b35">
    <rdf:first rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b33"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#Indicator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">측정지표</rdfs:label>
    <rdfs:label xml:lang="en">Indicator</rdfs:label>
    <rdfs:comment xml:lang="ko">기준을 측정하는 지표의 추상 클래스. 도메인 계층의 지표 클래스가 이 클래스의 하위클래스로 선언된다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b5">
    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#CostCriterion"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b39">
    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#OutrankingMethod"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#requiredRawValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">필요 원시값</rdfs:label>
    <rdfs:label xml:lang="en">required raw value</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CounterfactualCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#representsEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">표상 개체</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#Alternative"/>
    <rdfs:comment xml:lang="ko">대안이 표상하는 도메인 개체. 레인지를 두지 않는 것이 계층 독립의 조건이다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#Cost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/nrdp/mcdm#OptimizationDirection"/>
    <rdfs:label xml:lang="ko">비용(최소화)</rdfs:label>
    <rdfs:label xml:lang="en">Cost (minimise)</rdfs:label>
  </rdf:Description>
