    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b68"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#NonCompensatoryMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">비보상형 기법</rdfs:label>
    <rdfs:label xml:lang="en">Non-compensatory method</rdfs:label>
    <owl:equivalentClass rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b56"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasCompensationLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">보상 수준</rdfs:label>
