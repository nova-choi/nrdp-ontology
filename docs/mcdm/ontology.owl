  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#requiresNormalization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">정규화 필요</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#AggregationMethod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b24">
    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#IntervalScale"/>
    <rdf:rest rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b25"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b38">
    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#DistanceBasedMethod"/>
    <rdf:rest rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b39"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#DecisionScenario">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">의사결정 시나리오</rdfs:label>
    <rdfs:label xml:lang="en">Decision scenario</rdfs:label>
    <rdfs:comment xml:lang="ko">하나의 정책 선호 = 하나의 가중치 집합.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasDirection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">최적화방향</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#Criterion"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#OptimizationDirection"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#OrdinalScale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/nrdp/mcdm#MeasurementScale"/>
    <rdfs:label xml:lang="ko">순서척도</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b15">
    <rdf:first rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b13"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#MeasurementScale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">측정척도</rdfs:label>
    <rdfs:label xml:lang="en">Measurement scale</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b21">
    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#Cost"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#supportsAdditiveDecomposition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">가법 분해 가능</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#AggregationMethod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="ko">종합점수를 기준별 기여의 합으로 분해할 수 있는가. WSM·PROMETHEE II(단일기준 순흐름)는 true, TOPSIS는 false. CriterionContribution 은 이 값이 true인 기법의 결과에만 허용(SHACL).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b23">
    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#RatioScale"/>
    <rdf:rest rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b24"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#derivedFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    <rdfs:label xml:lang="ko">가중치 도출 근거</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#Weight"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#FullCompensation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/nrdp/mcdm#CompensationLevel"/>
    <rdfs:label xml:lang="ko">완전보상</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b49">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#hasCompensationLevel"/>
    <owl:someValuesFrom rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b50"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b40">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:oneOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b41"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#onCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">대상 기준</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CriterionValue"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#LeafCriterion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b20">
    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#Benefit"/>
    <rdf:rest rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b21"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#Explanation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="ko">설명</rdfs:label>
    <rdfs:label xml:lang="en">Explanation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#reflectsPolicyObjective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">반영 정책목표</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#DecisionScenario"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:comment xml:lang="ko">v0.2의 mcdm:reflectsPolicyGoal(레인지 nrdp:PolicyGoal)을 대체. 레인지를 skos:Concept로 두어 도메인 의존 제거(T11).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#scenarioLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#DecisionScenario"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">시나리오 설명</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#forProblem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#DecisionResult"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#DecisionProblem"/>
    <rdfs:label xml:lang="ko">대상 의사결정문제</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b19">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
    <owl:distinctMembers rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b20"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b69">
    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#EvidencePath"/>
    <rdf:rest rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b70"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b31">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <owl:withRestrictions rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b34"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b13">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#hasDirection"/>
    <owl:hasValue rdf:resource="https://w3id.org/nrdp/mcdm#Cost"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#inProblem"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/nrdp/mcdm#DecisionProblem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasNormalizedValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="ko">정규화값(v0.1, 폐기)</rdfs:label>
    <rdfs:comment xml:lang="ko">v0.1 전용. v0.2부터 NormalizedValue 패턴으로 대체.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasSubCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label xml:lang="ko">하위기준</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CompositeCriterion"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#Criterion"/>
    <rdfs:comment xml:lang="ko">T1: 추이적 선언을 제거하고 비반사·비대칭(단순 역할)으로 선언. 계층 전체 탐색은 질의의 전이 폐쇄(SPARQL hasSubCriterion+, Cypher *1..)로 처리한다. OWL 2 DL은 추이적(비단순) 속성에 비반사·비대칭 공리를 허용하지 않으므로 둘 중 하나를 택해야 하며, 순환 계층 방지가 더 근본적이라 판단했다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b60">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#forProblem"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/nrdp/mcdm#DecisionProblem"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b61">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#forScenario"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/nrdp/mcdm#DecisionScenario"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b4"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b62">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#byMethod"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/nrdp/mcdm#AggregationMethod"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b57">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#hasCompensationLevel"/>
    <owl:hasValue rdf:resource="https://w3id.org/nrdp/mcdm#NonCompensation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#NormalizationActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="ko">정규화 수행</rdfs:label>
    <rdfs:label xml:lang="en">Normalization run</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasContributionValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">기여값</rdfs:label>
    <rdfs:label xml:lang="en">contribution value</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CriterionContribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="ko">종합점수 가운데 해당 기준의 몫. 한 결과의 기준별 기여값을 모두 더하면 종합점수와 같다(SHACL M7). WSM은 w_j·r_ij, PROMETHEE II는 w_j·φ_j(a). v0.3.4 추가: 순흐름이 0 이하인 결과에서는 기여비율이 정의되지 않으므로 절대값으로 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#NonCompensation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/nrdp/mcdm#CompensationLevel"/>
    <rdfs:label xml:lang="ko">비보상</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#NormalizedValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b28"/>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b29"/>
    <rdfs:label xml:lang="ko">정규화값</rdfs:label>
    <rdfs:label xml:lang="en">Normalized value</rdfs:label>
    <rdfs:comment xml:lang="ko">평가값×정규화방법의 재화(v0.2). prov:wasGeneratedBy 는 NormalizationActivity 여야 한다(T7: v0.2 데이터에서 원시값에 걸려 있던 생성 관계를 이쪽으로 이동).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#DecisionResult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">점수</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#LeafCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nrdp/mcdm#Criterion"/>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b2"/>
    <owl:disjointWith rdf:resource="https://w3id.org/nrdp/mcdm#CompositeCriterion"/>
    <rdfs:label xml:lang="ko">리프 기준</rdfs:label>
    <rdfs:label xml:lang="en">Leaf criterion</rdfs:label>
    <rdfs:comment xml:lang="ko">평가값이 직접 부여되는 기준. 최적화 방향을 정확히 하나 가진다.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b3"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b30">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#assignedToCriterion"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/nrdp/mcdm#Criterion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b17">
    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#Benefit"/>
    <rdf:rest rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b18"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b54">
    <rdf:first rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b49"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#CompositeCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nrdp/mcdm#Criterion"/>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b6"/>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b7"/>
    <rdfs:label xml:lang="ko">상위 기준</rdfs:label>
    <rdfs:label xml:lang="en">Composite criterion</rdfs:label>
    <rdfs:comment xml:lang="ko">하위기준을 묶는 상위 기준. 방향을 갖지 않는다(v0.2의 '혁신역량' 문제 해소).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#IntervalScale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/nrdp/mcdm#MeasurementScale"/>
    <rdfs:label xml:lang="ko">등간척도</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#CostCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">비용형 기준</rdfs:label>
    <rdfs:label xml:lang="en">Cost criterion</rdfs:label>
    <owl:equivalentClass rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b12"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#CompensationLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">보상 수준</rdfs:label>
    <rdfs:label xml:lang="en">Compensation level</rdfs:label>
    <owl:equivalentClass rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b40"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b33">
    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</xsd:maxInclusive>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#hasDirection"/>
    <owl:hasValue rdf:resource="https://w3id.org/nrdp/mcdm#Benefit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasScale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">측정척도</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#LeafCriterion"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#MeasurementScale"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#DecisionProblem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">의사결정문제</rdfs:label>
    <rdfs:label xml:lang="en">Decision problem</rdfs:label>
    <rdfs:comment xml:lang="ko">대안 집합과 기준 집합을 묶는 하나의 평가 과업.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#RatioScale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/nrdp/mcdm#MeasurementScale"/>
    <rdfs:label xml:lang="ko">비율척도</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#usesPreferenceFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#AggregationMethod"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#PreferenceFunction"/>
    <rdfs:label xml:lang="ko">사용 선호함수</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b65">
    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b43">
    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#NonCompensation"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasContributionRatio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CriterionContribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="ko">기준의 기여값을 종합점수로 나눈 비율. 종합점수가 양수인 결과에서만 해석할 수 있다(v0.3.4 주석 추가).</rdfs:comment>
    <rdfs:label xml:lang="ko">기여비율</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b63">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#forAlternative"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/nrdp/mcdm#Alternative"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#usesNormalization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#AggregationMethod"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#NormalizationMethod"/>
    <rdfs:label xml:lang="ko">사용 정규화방법</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#byMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#DecisionResult"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#AggregationMethod"/>
    <rdfs:label xml:lang="ko">적용 기법</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#CompensatoryMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">보상 허용 기법</rdfs:label>
    <rdfs:label xml:lang="en">Compensation-admitting method</rdfs:label>
    <rdfs:comment xml:lang="ko">정의 클래스. 보상 수준이 완전 또는 부분인 기법으로 추론된다. 집계 논리 3계열과 직교하는 분류 축이다. 보상 수준은 기법 개체(파라미터를 포함한 구성)에 기록하므로, 선형 선호함수를 쓰는 PROMETHEE II처럼 아웃랭킹 논리이면서 부분 보상인 기법도 이 클래스에 속한다. v0.3.2에서 라벨을 '보상형 기법'에서 '보상 허용 기법'으로 변경.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b48"/>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b55"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasRawValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">원시값</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CriterionValue"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b28">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#ofCriterionValue"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/nrdp/mcdm#CriterionValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">단위</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CriterionValue"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b4">
    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#BenefitCriterion"/>
    <rdf:rest rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b5"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b10"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#OptimizationDirection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">최적화방향</rdfs:label>
    <rdfs:label xml:lang="en">Optimization direction</rdfs:label>
    <owl:equivalentClass rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b16"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">정규화값(수치)</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#NormalizedValue"/>
    <rdfs:comment xml:lang="ko">v0.3.2: v0.3.0의 [0,1] 데이터타입 제한을 해제하였다. 벡터 정규화·z-score 등은 원시값의 부호에 따라 [0,1] 밖의 값을 내므로, 허용 범위는 정규화방법 개체의 normalizedLowerBound·normalizedUpperBound 로 기록하고 SHACL(mcdm-shapes.ttl M6)로 검사한다. 정규화방법을 데이터 계층 개체로 열어 두기 위한 설계 선택이며, 정규화방법을 스키마의 명명 개체로 둔다면 OWL 2 DL의 hasValue 제한과 데이터 범위 제한으로도 표현할 수 있다.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#EvaluationActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="ko">평가 실행</rdfs:label>
    <rdfs:label xml:lang="en">Evaluation run</rdfs:label>
    <rdfs:comment xml:lang="ko">한 (시나리오, 기법) 조합의 계산 실행. DecisionResult 는 이 활동으로 생성된다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b46">
    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#PartialCompensation"/>
    <rdf:rest rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b47"/>
  </rdf:Description>
