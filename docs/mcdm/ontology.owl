<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b22">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
    <owl:distinctMembers rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b23"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#ofAlternative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">대상 대안</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CriterionValue"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#Alternative"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#isFeasible">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">실현가능성</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CounterfactualCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#forScenario">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#DecisionResult"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#DecisionScenario"/>
    <rdfs:label xml:lang="ko">적용 시나리오</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#explains">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#Explanation"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#DecisionResult"/>
    <rdfs:label xml:lang="ko">설명 대상 결과</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b12">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b14"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#requiredNormalizedValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">필요 정규화값</rdfs:label>
    <rdfs:label xml:lang="en">required normalized value</rdfs:label>
    <rdfs:comment xml:lang="ko">목표 순위 진입에 필요한 해당 기준의 정규화값. 1.0을 넘으면 관측 범위 밖이므로 isFeasible=false. 정규화값과 같은 범위 검사(SHACL M6)는 적용하지 않는다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CounterfactualCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#Benefit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/nrdp/mcdm#OptimizationDirection"/>
    <rdfs:label xml:lang="ko">편익(최대화)</rdfs:label>
    <rdfs:label xml:lang="en">Benefit (maximise)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#CriterionValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b26"/>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b27"/>
    <rdfs:label xml:lang="ko">평가값</rdfs:label>
    <rdfs:label xml:lang="en">Criterion value</rdfs:label>
    <rdfs:comment xml:lang="ko">대안×리프기준의 원시 평가값. prov:wasDerivedFrom 으로 도메인 관측치에 연결된다.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://w3id.org/nrdp/mcdm#Explanation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#preferenceThresholdP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">선호 임계값 p</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#PreferenceFunction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#forAlternative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">대상 대안</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#DecisionResult"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#Alternative"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#Criterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">평가기준</rdfs:label>
    <rdfs:label xml:lang="en">Criterion</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#DistanceBasedMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nrdp/mcdm#AggregationMethod"/>
    <rdfs:label xml:lang="ko">거리기반 기법</rdfs:label>
    <rdfs:label xml:lang="en">Distance-based method</rdfs:label>
    <rdfs:comment xml:lang="ko">TOPSIS 등 기준점과의 거리 기반.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#Alternative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">대안</rdfs:label>
    <rdfs:label xml:lang="en">Alternative</rdfs:label>
    <rdfs:comment xml:lang="ko">평가 대상이 특정 의사결정 문제 안에서 맡는 역할(Agent-Role ODP). 도메인 개체와 동일시하지 않는다.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasNormalization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">정규화값 보유</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CriterionValue"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#NormalizedValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#Weight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">가중치</rdfs:label>
    <rdfs:label xml:lang="en">Weight</rdfs:label>
    <rdfs:comment xml:lang="ko">기준의 고유 속성이 아니라 시나리오에 종속되는 개체. 시나리오 내 가중치 합 = 1은 SHACL-SPARQL로 위임.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b30"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#PartialCompensation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/nrdp/mcdm#CompensationLevel"/>
    <rdfs:label xml:lang="ko">부분보상</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#normalizedLowerBound">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">정규화값 허용 하한</rdfs:label>
    <rdfs:label xml:lang="en">normalized value lower bound</rdfs:label>
    <rdfs:comment xml:lang="ko">이 방법이 산출하는 정규화값의 허용 하한. 없으면 하한을 검사하지 않는다(SHACL M6).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#NormalizationMethod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#ofCriterionValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">원평가값</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#NormalizedValue"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#CriterionValue"/>
    <owl:inverseOf rdf:resource="https://w3id.org/nrdp/mcdm#hasNormalization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b64">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <owl:withRestrictions rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b66"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#CounterfactualCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nrdp/mcdm#Explanation"/>
    <rdfs:label xml:lang="ko">반사실적 설명</rdfs:label>
    <rdfs:label xml:lang="en">Counterfactual explanation</rdfs:label>
    <rdfs:comment xml:lang="ko">목표 결과(예: 순위 진입)에 필요한 기준별 입력 변화. 본문 용어 '반사실적 설명'에 맞춰 v0.3.2에서 라벨 변경.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">Method-agnostic MCDM representation layer</dcterms:title>
    <dcterms:title xml:lang="ko">방법 중립적 MCDM 표현 계층</dcterms:title>
    <dcterms:creator>최혜석</dcterms:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <owl:versionIRI rdf:resource="https://w3id.org/nrdp/mcdm/0.3.5"/>
    <dcterms:description xml:lang="ko">국가 R&amp;D 포트폴리오 평가를 위해 설계한 방법 중립적 MCDM 표현 계층. 기준·가중치·정책 시나리오·정규화·집계기법·평가 결과와 그 설명(기준별 기여, 원천 경로, 반사실적 설명)을 특정 기법에 종속되지 않게 표현하며, 도메인 계층과 독립적으로 재사용할 수 있다.</dcterms:description>
    <dcterms:description xml:lang="en">A method-agnostic MCDM representation layer: criteria, weights, policy scenarios, normalisation, aggregation methods, decision results and their explanations, independent of any single MCDM method and of the application domain.</dcterms:description>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-31</dcterms:modified>
    <vann:preferredNamespacePrefix>mcdm</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/nrdp/mcdm#</vann:preferredNamespaceUri>
    <owl:versionInfo>0.3.5</owl:versionInfo>
    <owl:priorVersion rdf:resource="https://w3id.org/nrdp/mcdm/0.3.4"/>
    <rdfs:comment xml:lang="ko">v0.3.5: 공개용 메타데이터(설명, 수정일, 선호 접두어·네임스페이스) 추가. 논리 공리는 v0.3.4와 동일.</rdfs:comment>
    <rdfs:comment xml:lang="ko">v0.3: 도메인 독립 모듈로 분리. 기준 방향 공리를 리프 기준으로 한정, 집계기법을 집계 논리(가치함수·거리·열위관계)와 보상 수준의 두 축으로 분해, PROV-O 정렬 선언.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b11">
    <rdf:first rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b9"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b27">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#onCriterion"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/nrdp/mcdm#LeafCriterion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasAlternative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">대안 보유</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#DecisionProblem"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#Alternative"/>
    <owl:inverseOf rdf:resource="https://w3id.org/nrdp/mcdm#inProblem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#OutrankingMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/nrdp/mcdm#AggregationMethod"/>
    <rdfs:label xml:lang="ko">아웃랭킹형 기법</rdfs:label>
    <rdfs:label xml:lang="en">Outranking method</rdfs:label>
    <rdfs:comment xml:lang="ko">PROMETHEE·ELECTRE 등 쌍대 선호관계 기반.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#requiredWeightValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">필요 가중치</rdfs:label>
    <rdfs:label xml:lang="en">required weight value</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#CounterfactualCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="ko">목표 결과(예: 두 대안의 순위 역전)에 필요한 해당 기준의 조정 후 가중치. 나머지 기준의 가중치는 합이 1이 되도록 비례 재조정한다고 가정한다. 순위 역전 조건은 두 대안의 결과를 모두 mcdm:explains 로 가리킨다. v0.3.4 추가(CQ25).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#hasDirection"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/nrdp/mcdm#OptimizationDirection"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#assignedToCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="ko">적용 기준</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#Weight"/>
    <rdfs:range rdf:resource="https://w3id.org/nrdp/mcdm#Criterion"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#Activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b26">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/nrdp/mcdm#ofAlternative"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/nrdp/mcdm#Alternative"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/nrdp/mcdm#hasPreferenceModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/nrdp/mcdm#AggregationMethod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">선호 모형</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b44">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
    <owl:distinctMembers rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b45"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf3ffc2e895a54fd091df0bed9983acc4b10">
    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#Criterion"/>
