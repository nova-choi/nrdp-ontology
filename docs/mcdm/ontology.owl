    <rdf:first rdf:resource="https://w3id.org/nrdp/mcdm#OrdinalScale"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
