  {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ]
  },
  {
    "@id": "https://w3id.org/nrdp/mcdm#CompensatoryMethod",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "정의 클래스. 보상 수준이 완전 또는 부분인 기법으로 추론된다. 집계 논리 3계열과 직교하는 분류 축이다. 보상 수준은 기법 개체(파라미터를 포함한 구성)에 기록하므로, 선형 선호함수를 쓰는 PROMETHEE II처럼 아웃랭킹 논리이면서 부분 보상인 기법도 이 클래스에 속한다. v0.3.2에서 라벨을 '보상형 기법'에서 '보상 허용 기법'으로 변경."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "보상 허용 기법"
      },
      {
        "@language": "en",
        "@value": "Compensation-admitting method"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:nf3ffc2e895a54fd091df0bed9983acc4b55"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:nf3ffc2e895a54fd091df0bed9983acc4b48"
      }
    ]
  },
