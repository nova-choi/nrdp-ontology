      {
        "@id": "https://w3id.org/nrdp/mcdm#requiresNormalization"
      }
    ]
  },
  {
    "@id": "https://w3id.org/nrdp/mcdm#normalizedUpperBound",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "이 방법이 산출하는 정규화값의 허용 상한. 없으면 상한을 검사하지 않는다(SHACL M6)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/nrdp/mcdm#NormalizationMethod"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "정규화값 허용 상한"
      },
      {
        "@language": "en",
        "@value": "normalized value upper bound"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/nrdp/mcdm#hasContributionValue",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "종합점수 가운데 해당 기준의 몫. 한 결과의 기준별 기여값을 모두 더하면 종합점수와 같다(SHACL M7). WSM은 w_j·r_ij, PROMETHEE II는 w_j·φ_j(a). v0.3.4 추가: 순흐름이 0 이하인 결과에서는 기여비율이 정의되지 않으므로 절대값으로 기록한다."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/nrdp/mcdm#CriterionContribution"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "기여값"
      },
      {
        "@language": "en",
        "@value": "contribution value"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
