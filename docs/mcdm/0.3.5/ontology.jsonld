    ]
  },
  {
    "@id": "https://w3id.org/nrdp/mcdm#hasValue",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "v0.3.2: v0.3.0의 [0,1] 데이터타입 제한을 해제하였다. 벡터 정규화·z-score 등은 원시값의 부호에 따라 [0,1] 밖의 값을 내므로, 허용 범위는 정규화방법 개체의 normalizedLowerBound·normalizedUpperBound 로 기록하고 SHACL(mcdm-shapes.ttl M6)로 검사한다. 정규화방법을 데이터 계층 개체로 열어 두기 위한 설계 선택이며, 정규화방법을 스키마의 명명 개체로 둔다면 OWL 2 DL의 hasValue 제한과 데이터 범위 제한으로도 표현할 수 있다."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/nrdp/mcdm#NormalizedValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "정규화값(수치)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
