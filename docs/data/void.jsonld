      },
      {
        "@id": "https://w3id.org/nrdp/kosv/0.1.1"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "최혜석"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "ko",
        "@value": "국가전략기술 3개 분야(반도체·디스플레이, 첨단바이오, 인공지능) 세부사업 41개의 2015~2024년 과제·성과·예산·분류 이력과, 이 사업들에 정책 시나리오 3종과 MCDM 기법 3종(WSM, TOPSIS, PROMETHEE II)을 적용한 평가 결과·설명을 nrdp 온톨로지 어휘로 표현한 지식그래프. 평가 기준과 시나리오 가중치는 방법 중립성을 보이기 위한 연구자 설정값이며, 평가 결과는 특정 사업의 우열에 대한 정책적 판단이 아니다."
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-10-23"
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/rights": [
      {
        "@language": "ko",
        "@value": "원자료: 한국과학기술정보연구원, 국가과학기술지식정보서비스(NTIS) OpenAPI 과제검색·성과검색(공공누리 제1유형), 2026년 10월 수집. 본 데이터는 원자료를 RDF로 변환·집계한 가공본이다."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.ntis.go.kr/"
      }
    ],
    "http://purl.org/dc/terms/temporal": [
