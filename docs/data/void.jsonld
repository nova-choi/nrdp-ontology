    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "ko",
        "@value": "국가 R&D 포트폴리오 실데이터 지식그래프 (NTIS, 국가전략기술 3개 분야)"
      },
      {
        "@language": "en",
        "@value": "National R&D portfolio knowledge graph from NTIS (three national strategic technology fields)"
      }
