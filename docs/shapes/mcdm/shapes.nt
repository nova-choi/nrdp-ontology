_:nd48065a5477e40eaad20364556227d19b2 <http://www.w3.org/ns/shacl#message> "M1: 시나리오 {$this} 의 가중치 합이 {?sum} (1이어야 함)" .
<https://w3id.org/nrdp/mcdm#NormalizedValueKeyShape> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#NodeShape> .
_:nd48065a5477e40eaad20364556227d19b7 <http://www.w3.org/ns/shacl#select> "\n          SELECT $this ?cv ?nm WHERE {\n            $this mcdm:ofCriterionValue ?cv ; mcdm:normalizedBy ?nm .\n            ?o mcdm:ofCriterionValue ?cv ; mcdm:normalizedBy ?nm .\n            FILTER (?o != $this)\n          }\n          " .
<https://w3id.org/nrdp/shapes/mcdm> <http://purl.org/dc/terms/title> "SHACL shapes for the MCDM representation layer (M1-M7)"@en .
_:nd48065a5477e40eaad20364556227d19b3 <http://www.w3.org/ns/shacl#select> "\n          SELECT $this ?c WHERE {\n            $this mcdm:hasWeight ?w1 , ?w2 .\n            ?w1 mcdm:assignedToCriterion ?c . ?w2 mcdm:assignedToCriterion ?c .\n            FILTER (?w1 != ?w2)\n          } GROUP BY $this ?c\n          " .
<https://w3id.org/nrdp/mcdm#ContributionMethodShape> <http://www.w3.org/ns/shacl#sparql> _:nd48065a5477e40eaad20364556227d19b6 .
<https://w3id.org/nrdp/shapes/mcdm> <http://www.w3.org/2002/07/owl#versionIRI> <https://w3id.org/nrdp/shapes/mcdm/0.3.5> .
<https://w3id.org/nrdp/mcdm#ContributionMethodShape> <http://www.w3.org/ns/shacl#targetClass> <https://w3id.org/nrdp/mcdm#CriterionContribution> .
_:nd48065a5477e40eaad20364556227d19b8 <http://www.w3.org/ns/shacl#select> "\n          SELECT $this ?c WHERE {\n            { $this mcdm:inProblem ?p } UNION { ?p mcdm:hasAlternative $this }\n            ?p mcdm:hasCriterion ?c .\n            FILTER NOT EXISTS { ?c mcdm:hasSubCriterion ?sub }\n            FILTER NOT EXISTS { ?cv mcdm:ofAlternative $this ; mcdm:onCriterion ?c }\n          }\n          " .
_:nd48065a5477e40eaad20364556227d19b4 <http://www.w3.org/ns/shacl#select> "\n          SELECT $this ?r ?y WHERE {\n            $this mcdm:forProblem ?p ; mcdm:forScenario ?s ; mcdm:byMethod ?m ; mcdm:hasRank ?r .\n            ?y mcdm:forProblem ?p ; mcdm:forScenario ?s ; mcdm:byMethod ?m ; mcdm:hasRank ?r .\n            FILTER (?y != $this)\n          }\n          " .
_:nd48065a5477e40eaad20364556227d19b6 <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/nrdp/mcdm#sh_prefixes> .
<https://w3id.org/nrdp/mcdm#ScenarioWeightSumShape> <http://www.w3.org/ns/shacl#targetClass> <https://w3id.org/nrdp/mcdm#DecisionScenario> .
