_:nd48065a5477e40eaad20364556227d19b9 <http://www.w3.org/ns/shacl#select> "\n          SELECT $this ?v ?nm WHERE {\n            $this mcdm:hasValue ?v ; mcdm:normalizedBy ?nm .\n            OPTIONAL { ?nm mcdm:normalizedLowerBound ?lo }\n            OPTIONAL { ?nm mcdm:normalizedUpperBound ?hi }\n            FILTER ( (BOUND(?lo) && ?v < ?lo) || (BOUND(?hi) && ?v > ?hi) )\n          }\n          " .
_:nd48065a5477e40eaad20364556227d19b9 <http://www.w3.org/ns/shacl#prefixes> <https://w3id.org/nrdp/mcdm#sh_prefixes> .
_:nd48065a5477e40eaad20364556227d19b10 <http://www.w3.org/ns/shacl#message> "M7: 결과 {$this} 의 기준별 기여값 합 {?sum} 이 점수 {?s} 와 다름" .
