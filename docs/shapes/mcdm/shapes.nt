_:nd48065a5477e40eaad20364556227d19b10 <http://www.w3.org/ns/shacl#select> "\n          SELECT $this ?s (SUM(?v) AS ?sum) WHERE {\n            $this mcdm:hasScore ?s .\n            ?cc mcdm:explains $this ; mcdm:hasContributionValue ?v .\n          } GROUP BY $this ?s\n            HAVING (ABS(SUM(?v) - ?s) > 0.0001)\n          " .
_:nd48065a5477e40eaad20364556227d19b2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
_:nd48065a5477e40eaad20364556227d19b5 <http://www.w3.org/ns/shacl#select> "\n          SELECT $this ?r (COUNT(DISTINCT ?x) AS ?n) WHERE {\n            $this mcdm:forProblem ?p ; mcdm:forScenario ?s ; mcdm:byMethod ?m ; mcdm:hasRank ?r .\n            ?x mcdm:forProblem ?p ; mcdm:forScenario ?s ; mcdm:byMethod ?m .\n          } GROUP BY $this ?r\n            HAVING (?r > COUNT(DISTINCT ?x))\n          " .
