@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mcdm: <https://w3id.org/nrdp/mcdm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mcdm:ContributionMethodShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "M3: 기여 분해 {$this} 의 대상 결과가 가산 분해를 지원하지 않는 기법 {?m} 의 산출임" ;
            sh:prefixes mcdm:sh_prefixes ;
            sh:select """
          SELECT $this ?m WHERE {
            $this mcdm:explains ?dr . ?dr mcdm:byMethod ?m .
            FILTER NOT EXISTS { ?m mcdm:supportsAdditiveDecomposition true }
          }
          """ ] ;
    sh:targetClass mcdm:CriterionContribution .

mcdm:ContributionSumShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "M7: 결과 {$this} 의 기준별 기여값 합 {?sum} 이 점수 {?s} 와 다름" ;
            sh:prefixes mcdm:sh_prefixes ;
            sh:select """
          SELECT $this ?s (SUM(?v) AS ?sum) WHERE {
            $this mcdm:hasScore ?s .
            ?cc mcdm:explains $this ; mcdm:hasContributionValue ?v .
          } GROUP BY $this ?s
            HAVING (ABS(SUM(?v) - ?s) > 0.0001)
          """ ] ;
    sh:targetClass mcdm:DecisionResult .

mcdm:MissingCriterionValueShape a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "M5: 대안 {$this} 의 리프 기준 {?c} 평가값 없음" ;
            sh:prefixes mcdm:sh_prefixes ;
            sh:select """
          SELECT $this ?c WHERE {
            { $this mcdm:inProblem ?p } UNION { ?p mcdm:hasAlternative $this }
            ?p mcdm:hasCriterion ?c .
            FILTER NOT EXISTS { ?c mcdm:hasSubCriterion ?sub }
            FILTER NOT EXISTS { ?cv mcdm:ofAlternative $this ; mcdm:onCriterion ?c }
          }
          """ ] ;
    sh:targetClass mcdm:Alternative .

mcdm:NormalizedValueKeyShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "M4: 평가값 {?cv} 와 정규화방법 {?nm} 쌍에 정규화값이 둘 이상" ;
            sh:prefixes mcdm:sh_prefixes ;
            sh:select """
          SELECT $this ?cv ?nm WHERE {
            $this mcdm:ofCriterionValue ?cv ; mcdm:normalizedBy ?nm .
            ?o mcdm:ofCriterionValue ?cv ; mcdm:normalizedBy ?nm .
            FILTER (?o != $this)
          }
          """ ] ;
    sh:targetClass mcdm:NormalizedValue .

mcdm:NormalizedValueRangeShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "M6: 정규화값 {?v} 가 정규화방법 {?nm} 의 허용 범위 밖" ;
            sh:prefixes mcdm:sh_prefixes ;
            sh:select """
          SELECT $this ?v ?nm WHERE {
            $this mcdm:hasValue ?v ; mcdm:normalizedBy ?nm .
            OPTIONAL { ?nm mcdm:normalizedLowerBound ?lo }
            OPTIONAL { ?nm mcdm:normalizedUpperBound ?hi }
            FILTER ( (BOUND(?lo) && ?v < ?lo) || (BOUND(?hi) && ?v > ?hi) )
          }
          """ ] ;
    sh:targetClass mcdm:NormalizedValue .

mcdm:RankPermutationShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "M2: 순위 {?r} 가 같은 (문제, 시나리오, 기법) 안의 다른 결과 {?y} 와 중복" ;
            sh:prefixes mcdm:sh_prefixes ;
            sh:select """
          SELECT $this ?r ?y WHERE {
            $this mcdm:forProblem ?p ; mcdm:forScenario ?s ; mcdm:byMethod ?m ; mcdm:hasRank ?r .
            ?y mcdm:forProblem ?p ; mcdm:forScenario ?s ; mcdm:byMethod ?m ; mcdm:hasRank ?r .
            FILTER (?y != $this)
          }
          """ ],
        [ a sh:SPARQLConstraint ;
            sh:message "M2: 순위 {?r} 가 같은 (문제, 시나리오, 기법) 안의 결과 수 {?n} 를 넘음" ;
            sh:prefixes mcdm:sh_prefixes ;
            sh:select """
          SELECT $this ?r (COUNT(DISTINCT ?x) AS ?n) WHERE {
            $this mcdm:forProblem ?p ; mcdm:forScenario ?s ; mcdm:byMethod ?m ; mcdm:hasRank ?r .
            ?x mcdm:forProblem ?p ; mcdm:forScenario ?s ; mcdm:byMethod ?m .
          } GROUP BY $this ?r
            HAVING (?r > COUNT(DISTINCT ?x))
          """ ] ;
    sh:targetClass mcdm:DecisionResult .

mcdm:ScenarioWeightSumShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "M1: 시나리오 {$this} 의 가중치 합이 {?sum} (1이어야 함)" ;
            sh:prefixes mcdm:sh_prefixes ;
            sh:select """
          SELECT $this (SUM(?v) AS ?sum) WHERE {
            $this mcdm:hasWeight ?w .
            OPTIONAL { ?w mcdm:hasWeightValue ?wv }
            BIND (COALESCE(?wv, 0) AS ?v)
          } GROUP BY $this
            HAVING (ABS(SUM(?v) - 1.0) > 0.0001)
          """ ],
        [ a sh:SPARQLConstraint ;
            sh:message "M1: 시나리오 {$this} 에서 기준 {?c} 에 가중치가 둘 이상 부여됨" ;
            sh:prefixes mcdm:sh_prefixes ;
            sh:select """
          SELECT $this ?c WHERE {
            $this mcdm:hasWeight ?w1 , ?w2 .
            ?w1 mcdm:assignedToCriterion ?c . ?w2 mcdm:assignedToCriterion ?c .
            FILTER (?w1 != ?w2)
          } GROUP BY $this ?c
          """ ] ;
    sh:targetClass mcdm:DecisionScenario .

<https://w3id.org/nrdp/shapes/mcdm> a owl:Ontology ;
    dcterms:creator "최혜석" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-31"^^xsd:date ;
    dcterms:requires <https://w3id.org/nrdp/mcdm/0.3.5> ;
    dcterms:title "SHACL shapes for the MCDM representation layer (M1-M7)"@en,
        "MCDM 표현 계층 SHACL shape (M1~M7)"@ko ;
    owl:versionIRI <https://w3id.org/nrdp/shapes/mcdm/0.3.5> ;
    owl:versionInfo "0.3.5" .

mcdm:sh_prefixes a owl:Ontology ;
    sh:declare [ sh:namespace "https://w3id.org/nrdp/mcdm#"^^xsd:anyURI ;
            sh:prefix "mcdm" ] .

