_:nb46259a6340943a2868dd37de995b665b12 <http://www.w3.org/ns/shacl#select> "\n          SELECT $this ?c ?ed WHERE {\n            ?corr xkos:madeOf $this .\n            { ?corr kosv:sourceEdition ?ed . $this xkos:sourceConcept ?c . }\n            UNION\n            { ?corr kosv:targetEdition ?ed . $this xkos:targetConcept ?c . }\n            FILTER NOT EXISTS { ?c skos:inScheme ?ed }\n          }" .
<https://w3id.org/nrdp/kosv#AllocationShareShape> <http://www.w3.org/ns/shacl#property> _:nb46259a6340943a2868dd37de995b665b13 .
