    nrdp:fundedBy ex:MIN_MSIT ;
    nrdp:managedBy ex:AG_IITP ;
    nrdp:belongsToField ex:TF_SEMI ;
    nrdp:contributesTo ex:PG_TECH ;
    nrdp:hasAllocation ex:BA_P02_2021, ex:BA_P02_2022, ex:BA_P02_2023 ;
