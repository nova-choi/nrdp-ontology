@prefix nrdp: <https://w3id.org/nrdp/ontology#> .
@prefix mcdm: <https://w3id.org/nrdp/mcdm#> .
@prefix ex:   <https://w3id.org/nrdp/data#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# 자동 생성된 샘플 데이터 (gen_data.py). 수치는 합성값이며 실제 통계가 아님.

### 회계연도
ex:FY2021 a nrdp:FiscalYear ; nrdp:yearValue "2021"^^xsd:integer ; rdfs:label "2021년" .
ex:FY2022 a nrdp:FiscalYear ; nrdp:yearValue "2022"^^xsd:integer ; rdfs:label "2022년" .
ex:FY2023 a nrdp:FiscalYear ; nrdp:yearValue "2023"^^xsd:integer ; rdfs:label "2023년" .

### 기술분야 (국가과학기술표준분류 예시코드)
ex:TF_AI a nrdp:TechnologyField ; rdfs:label "인공지능"@ko ; skos:notation "EF01" .
ex:TF_SEMI a nrdp:TechnologyField ; rdfs:label "반도체·디스플레이"@ko ; skos:notation "EF02" .
ex:TF_BIO a nrdp:TechnologyField ; rdfs:label "첨단바이오"@ko ; skos:notation "EF03" .

### 기관
ex:MIN_MSIT a nrdp:Ministry ; rdfs:label "과학기술정보통신부"@ko .
ex:MIN_MOTIE a nrdp:Ministry ; rdfs:label "산업통상자원부"@ko .
ex:AG_IITP a nrdp:FundingAgency ; rdfs:label "정보통신기획평가원"@ko .
ex:AG_KEIT a nrdp:FundingAgency ; rdfs:label "한국산업기술평가관리원"@ko .

### 연구수행기관
ex:OR_KAIST a nrdp:PerformingOrganization ; rdfs:label "한국과학기술원"@ko .
ex:OR_ETRI a nrdp:PerformingOrganization ; rdfs:label "한국전자통신연구원"@ko .
ex:OR_SNU a nrdp:PerformingOrganization ; rdfs:label "서울대학교"@ko .
ex:OR_KRIBB a nrdp:PerformingOrganization ; rdfs:label "한국생명공학연구원"@ko .
ex:OR_SKKU a nrdp:PerformingOrganization ; rdfs:label "성균관대학교"@ko .

### 세부사업 / 연구개발과제 (partOfProgram 추이적 연결)
ex:SP01 a nrdp:RnDSubProgram ; rdfs:label "AI원천기술"@ko ; nrdp:partOfProgram ex:P01 .
ex:SP02 a nrdp:RnDSubProgram ; rdfs:label "AI응용실증"@ko ; nrdp:partOfProgram ex:P01 .
ex:SP03 a nrdp:RnDSubProgram ; rdfs:label "합성생물학플랫폼"@ko ; nrdp:partOfProgram ex:P05 .
ex:PJ01 a nrdp:RnDProject ; rdfs:label "초거대모델경량화"@ko ; nrdp:partOfProgram ex:SP01 ; nrdp:performedBy ex:OR_KAIST, ex:OR_ETRI .
ex:PJ02 a nrdp:RnDProject ; rdfs:label "멀티모달추론기술"@ko ; nrdp:partOfProgram ex:SP01 ; nrdp:performedBy ex:OR_SNU .
ex:PJ03 a nrdp:RnDProject ; rdfs:label "제조AI실증"@ko ; nrdp:partOfProgram ex:SP02 ; nrdp:performedBy ex:OR_ETRI, ex:OR_SKKU .
ex:PJ04 a nrdp:RnDProject ; rdfs:label "유전자회로설계"@ko ; nrdp:partOfProgram ex:SP03 ; nrdp:performedBy ex:OR_KRIBB .
ex:PJ05 a nrdp:RnDProject ; rdfs:label "바이오파운드리"@ko ; nrdp:partOfProgram ex:SP03 ; nrdp:performedBy ex:OR_KRIBB, ex:OR_SNU .

### 정책목표
ex:PG_TECH a nrdp:PolicyGoal ; rdfs:label "기술주권 확보"@ko .
ex:PG_GROWTH a nrdp:PolicyGoal ; rdfs:label "혁신성장 견인"@ko .
ex:PG_SOCIAL a nrdp:PolicyGoal ; rdfs:label "사회문제 해결"@ko .

### 성과지표
ex:IND_EFF a nrdp:PerformanceIndicator ; rdfs:label "논문건수당투자효율"@ko ; nrdp:indicatorUnit "건/십억원" .
ex:IND_PAT a nrdp:PerformanceIndicator ; rdfs:label "특허출원건수"@ko ; nrdp:indicatorUnit "건" .
ex:IND_TT a nrdp:PerformanceIndicator ; rdfs:label "기술이전성공률"@ko ; nrdp:indicatorUnit "%" .
ex:IND_SOC a nrdp:PerformanceIndicator ; rdfs:label "사회적파급효과평점"@ko ; nrdp:indicatorUnit "점" .
ex:IND_BUD a nrdp:PerformanceIndicator ; rdfs:label "당해연도예산액"@ko ; nrdp:indicatorUnit "백만원" .
ex:IND_RISK a nrdp:PerformanceIndicator ; rdfs:label "수행위험도평점"@ko ; nrdp:indicatorUnit "점" .

### 국가연구개발사업
ex:P01 a nrdp:RnDProgram ;
    rdfs:label "차세대AI핵심기술개발"@ko ;
    nrdp:programCode "P01" ;
    nrdp:fundedBy ex:MIN_MSIT ;
    nrdp:managedBy ex:AG_IITP ;
    nrdp:belongsToField ex:TF_AI ;
    nrdp:contributesTo ex:PG_TECH, ex:PG_GROWTH ;
    nrdp:hasAllocation ex:BA_P01_2021, ex:BA_P01_2022, ex:BA_P01_2023 ;
    nrdp:hasObservation ex:OB_P01_PAP_2021, ex:OB_P01_PAT_2021, ex:OB_P01_PAP_2022, ex:OB_P01_PAT_2022, ex:OB_P01_PAP_2023, ex:OB_P01_PAT_2023 .
