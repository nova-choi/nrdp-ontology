### 정규화방법 / 선호함수 / 집계기법
ex:NM_MinMax a mcdm:NormalizationMethod ; rdfs:label "min-max 정규화"@ko .
ex:NM_Vector a mcdm:NormalizationMethod ; rdfs:label "벡터 정규화"@ko .
ex:PF_VShape a mcdm:PreferenceFunction ; rdfs:label "V-shape 선호함수"@ko ; mcdm:preferenceThresholdQ "0.0"^^xsd:decimal ; mcdm:preferenceThresholdP "0.5"^^xsd:decimal .

ex:M_WSM a mcdm:CompensatoryMethod ;
    rdfs:label "가중합법(WSM)"@ko ;
    mcdm:hasPreferenceModel "compensatory" ;
    mcdm:requiresNormalization "true"^^xsd:boolean ;
    mcdm:usesNormalization ex:NM_MinMax .
ex:M_TOPSIS a mcdm:CompensatoryMethod ;
    rdfs:label "TOPSIS"@ko ;
    mcdm:hasPreferenceModel "compensatory" ;
    mcdm:requiresNormalization "true"^^xsd:boolean ;
    mcdm:usesNormalization ex:NM_Vector .
ex:M_PRO2 a mcdm:OutrankingMethod ;
    rdfs:label "PROMETHEE II"@ko ;
    mcdm:hasPreferenceModel "non-compensatory" ;
    mcdm:requiresNormalization "true"^^xsd:boolean ;
    mcdm:usesNormalization ex:NM_MinMax ;
    mcdm:usesPreferenceFunction ex:PF_VShape .

