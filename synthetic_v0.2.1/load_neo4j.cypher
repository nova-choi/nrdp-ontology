// ═══════════════════════════════════════════════════════════════════
//  국가 R&D 포트폴리오 MCDM 온톨로지 — Neo4j 5.x 적재 스크립트
//  gen_neo4j_load.py 가 자동 생성. 직접 수정하지 마십시오.
//  노드 452개 / 관계 1057개  (합성 샘플 데이터 — 실제 통계 아님)
//  RDF 레이블 동기화 적용: 변경 15건 (label·scale 을 rdfs:label 기준으로 통일)
//
//  실행 방법
//   (권장) python run_cypher.py load_neo4j.cypher
//   (대안) Neo4j Browser 에서 '여러 문장 실행' 설정을 켜고 전체 붙여넣기
// ═══════════════════════════════════════════════════════════════════

// ── 0. 초기화: 기존 데이터 전부 삭제 (재실행 가능) ──
MATCH (n) DETACH DELETE n;

// ── 1. 고유성 제약조건 (id 로 조회하므로 인덱스 역할도 함) ──
CREATE CONSTRAINT agency_id IF NOT EXISTS FOR (n:Agency) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT alternative_id IF NOT EXISTS FOR (n:Alternative) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT budgetallocation_id IF NOT EXISTS FOR (n:BudgetAllocation) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT contribution_id IF NOT EXISTS FOR (n:Contribution) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT counterfactual_id IF NOT EXISTS FOR (n:Counterfactual) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT criterion_id IF NOT EXISTS FOR (n:Criterion) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT criterionvalue_id IF NOT EXISTS FOR (n:CriterionValue) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT decisionproblem_id IF NOT EXISTS FOR (n:DecisionProblem) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT decisionresult_id IF NOT EXISTS FOR (n:DecisionResult) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT fiscalyear_id IF NOT EXISTS FOR (n:FiscalYear) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT indicator_id IF NOT EXISTS FOR (n:Indicator) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT method_id IF NOT EXISTS FOR (n:Method) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ministry_id IF NOT EXISTS FOR (n:Ministry) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT normalization_id IF NOT EXISTS FOR (n:Normalization) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT normalizedvalue_id IF NOT EXISTS FOR (n:NormalizedValue) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT observation_id IF NOT EXISTS FOR (n:Observation) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT performer_id IF NOT EXISTS FOR (n:Performer) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT policygoal_id IF NOT EXISTS FOR (n:PolicyGoal) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT preferencefunction_id IF NOT EXISTS FOR (n:PreferenceFunction) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT program_id IF NOT EXISTS FOR (n:Program) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT project_id IF NOT EXISTS FOR (n:Project) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT provactivity_id IF NOT EXISTS FOR (n:ProvActivity) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT proventity_id IF NOT EXISTS FOR (n:ProvEntity) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT scenario_id IF NOT EXISTS FOR (n:Scenario) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT subprogram_id IF NOT EXISTS FOR (n:SubProgram) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT techfield_id IF NOT EXISTS FOR (n:TechField) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT weight_id IF NOT EXISTS FOR (n:Weight) REQUIRE n.id IS UNIQUE;

// ── 2. 노드 ──
UNWIND [{id: 'FY2021', year: 2021}, {id: 'FY2022', year: 2022}, {id: 'FY2023', year: 2023}] AS r
CREATE (n:FiscalYear) SET n = r;
UNWIND [{id: 'TF_AI', label: '인공지능', notation: 'EF01'}, {id: 'TF_SEMI', label: '반도체·디스플레이', notation: 'EF02'}, {id: 'TF_BIO', label: '첨단바이오', notation: 'EF03'}] AS r
CREATE (n:TechField) SET n = r;
UNWIND [{id: 'MIN_MSIT', label: '과학기술정보통신부'}, {id: 'MIN_MOTIE', label: '산업통상자원부'}] AS r
CREATE (n:Ministry:Organization) SET n = r;
UNWIND [{id: 'AG_IITP', label: '정보통신기획평가원'}, {id: 'AG_KEIT', label: '한국산업기술평가관리원'}] AS r
CREATE (n:Agency:Organization) SET n = r;
UNWIND [{id: 'OR_KAIST', label: '한국과학기술원'}, {id: 'OR_ETRI', label: '한국전자통신연구원'}, {id: 'OR_SNU', label: '서울대학교'}, {id: 'OR_KRIBB', label: '한국생명공학연구원'}, {id: 'OR_SKKU', label: '성균관대학교'}] AS r
CREATE (n:Performer:Organization) SET n = r;
UNWIND [{id: 'PG_TECH', label: '기술주권 확보'}, {id: 'PG_GROWTH', label: '혁신성장 견인'}, {id: 'PG_SOCIAL', label: '사회문제 해결'}] AS r
CREATE (n:PolicyGoal) SET n = r;
UNWIND [{id: 'IND_EFF', label: '논문건수당투자효율', unit: '건/십억원'}, {id: 'IND_PAT', label: '특허출원건수', unit: '건'}, {id: 'IND_TT', label: '기술이전성공률', unit: '%'}, {id: 'IND_SOC', label: '사회적파급효과평점', unit: '점'}, {id: 'IND_BUD', label: '당해연도예산액', unit: '백만원'}, {id: 'IND_RISK', label: '수행위험도평점', unit: '점'}] AS r
CREATE (n:Indicator) SET n = r;
UNWIND [{id: 'P01', code: 'P01', label: '차세대AI핵심기술개발'}, {id: 'P02', code: 'P02', label: 'AI반도체첨단공정실증'}, {id: 'P03', code: 'P03', label: '산업용AI융합확산'}, {id: 'P04', code: 'P04', label: '차세대반도체소재부품'}, {id: 'P05', code: 'P05', label: '합성생물학기반구축'}, {id: 'P06', code: 'P06', label: '디지털치료기기개발'}, {id: 'P07', code: 'P07', label: '첨단바이오제조혁신'}, {id: 'P08', code: 'P08', label: '공공AI서비스고도화'}, {id: 'P09', code: 'P09', label: '차세대통신핵심기술'}] AS r
CREATE (n:Program) SET n = r;
UNWIND [{id: 'BA_P01_2021', amount: 48000.0}, {id: 'BA_P01_2022', amount: 61000.0}, {id: 'BA_P01_2023', amount: 78000.0}, {id: 'BA_P02_2021', amount: 32000.0}, {id: 'BA_P02_2022', amount: 41000.0}, {id: 'BA_P02_2023', amount: 55000.0}, {id: 'BA_P03_2021', amount: 21000.0}, {id: 'BA_P03_2022', amount: 24000.0}, {id: 'BA_P03_2023', amount: 26000.0}, {id: 'BA_P04_2021', amount: 67000.0}, {id: 'BA_P04_2022', amount: 72000.0}, {id: 'BA_P04_2023', amount: 76000.0}, {id: 'BA_P05_2021', amount: 15000.0}, {id: 'BA_P05_2022', amount: 23000.0}, {id: 'BA_P05_2023', amount: 34000.0}, {id: 'BA_P06_2021', amount: 9000.0}, {id: 'BA_P06_2022', amount: 12000.0}, {id: 'BA_P06_2023', amount: 14000.0}, {id: 'BA_P07_2021', amount: 28000.0}, {id: 'BA_P07_2022', amount: 31000.0}, {id: 'BA_P07_2023', amount: 37000.0}, {id: 'BA_P08_2021', amount: 18000.0}, {id: 'BA_P08_2022', amount: 22000.0}, {id: 'BA_P08_2023', amount: 19000.0}, {id: 'BA_P09_2021', amount: 40000.0}, {id: 'BA_P09_2022', amount: 52000.0}, {id: 'BA_P09_2023', amount: 64000.0}] AS r
CREATE (n:BudgetAllocation) SET n = r;
UNWIND [{id: 'OB_P01_PAP_2021', value: 120.0}, {id: 'OB_P01_PAT_2021', value: 45.0}, {id: 'OB_P01_PAP_2022', value: 155.0}, {id: 'OB_P01_PAT_2022', value: 62.0}, {id: 'OB_P01_PAP_2023', value: 190.0}, {id: 'OB_P01_PAT_2023', value: 81.0}, {id: 'OB_P02_PAP_2021', value: 64.0}, {id: 'OB_P02_PAT_2021', value: 28.0}, {id: 'OB_P02_PAP_2022', value: 78.0}, {id: 'OB_P02_PAT_2022', value: 37.0}, {id: 'OB_P02_PAP_2023', value: 96.0}, {id: 'OB_P02_PAT_2023', value: 49.0}, {id: 'OB_P03_PAP_2021', value: 38.0}, {id: 'OB_P03_PAT_2021', value: 12.0}, {id: 'OB_P03_PAP_2022', value: 41.0}, {id: 'OB_P03_PAT_2022', value: 14.0}, {id: 'OB_P03_PAP_2023', value: 45.0}, {id: 'OB_P03_PAT_2023', value: 17.0}, {id: 'OB_P04_PAP_2021', value: 210.0}, {id: 'OB_P04_PAT_2021', value: 88.0}, {id: 'OB_P04_PAP_2022', value: 198.0}, {id: 'OB_P04_PAT_2022', value: 81.0}, {id: 'OB_P04_PAP_2023', value: 176.0}, {id: 'OB_P04_PAT_2023', value: 70.0}, {id: 'OB_P05_PAP_2021', value: 45.0}, {id: 'OB_P05_PAT_2021', value: 16.0}, {id: 'OB_P05_PAP_2022', value: 71.0}, {id: 'OB_P05_PAT_2022', value: 27.0}, {id: 'OB_P05_PAP_2023', value: 104.0}, {id: 'OB_P05_PAT_2023', value: 42.0}, {id: 'OB_P06_PAP_2021', value: 22.0}, {id: 'OB_P06_PAT_2021', value: 7.0}, {id: 'OB_P06_PAP_2022', value: 31.0}, {id: 'OB_P06_PAT_2022', value: 11.0}, {id: 'OB_P06_PAP_2023', value: 40.0}, {id: 'OB_P06_PAT_2023', value: 15.0}, {id: 'OB_P07_PAP_2021', value: 80.0}, {id: 'OB_P07_PAT_2021', value: 33.0}, {id: 'OB_P07_PAP_2022', value: 88.0}, {id: 'OB_P07_PAT_2022', value: 38.0}] AS r
CREATE (n:Observation) SET n = r;
UNWIND [{id: 'OB_P07_PAP_2023', value: 97.0}, {id: 'OB_P07_PAT_2023', value: 44.0}, {id: 'OB_P08_PAP_2021', value: 30.0}, {id: 'OB_P08_PAT_2021', value: 9.0}, {id: 'OB_P08_PAP_2022', value: 34.0}, {id: 'OB_P08_PAT_2022', value: 11.0}, {id: 'OB_P08_PAP_2023', value: 31.0}, {id: 'OB_P08_PAT_2023', value: 10.0}, {id: 'OB_P09_PAP_2021', value: 95.0}, {id: 'OB_P09_PAT_2021', value: 40.0}, {id: 'OB_P09_PAP_2022', value: 118.0}, {id: 'OB_P09_PAT_2022', value: 51.0}, {id: 'OB_P09_PAP_2023', value: 141.0}, {id: 'OB_P09_PAT_2023', value: 63.0}] AS r
CREATE (n:Observation) SET n = r;
UNWIND [{id: 'SP01', label: 'AI원천기술'}, {id: 'SP02', label: 'AI응용실증'}, {id: 'SP03', label: '합성생물학플랫폼'}] AS r
CREATE (n:SubProgram) SET n = r;
UNWIND [{id: 'PJ01', label: '초거대모델경량화'}, {id: 'PJ02', label: '멀티모달추론기술'}, {id: 'PJ03', label: '제조AI실증'}, {id: 'PJ04', label: '유전자회로설계'}, {id: 'PJ05', label: '바이오파운드리'}] AS r
CREATE (n:Project) SET n = r;
UNWIND [{id: 'DP1', label: '2023년 전략기술 3개 분야 R&D 포트폴리오 평가'}] AS r
CREATE (n:DecisionProblem) SET n = r;
UNWIND [{id: 'ALT_P01', label: '차세대AI핵심기술개발(대안)'}, {id: 'ALT_P02', label: 'AI반도체첨단공정실증(대안)'}, {id: 'ALT_P03', label: '산업용AI융합확산(대안)'}, {id: 'ALT_P04', label: '차세대반도체소재부품(대안)'}, {id: 'ALT_P05', label: '합성생물학기반구축(대안)'}, {id: 'ALT_P06', label: '디지털치료기기개발(대안)'}, {id: 'ALT_P07', label: '첨단바이오제조혁신(대안)'}, {id: 'ALT_P08', label: '공공AI서비스고도화(대안)'}, {id: 'ALT_P09', label: '차세대통신핵심기술(대안)'}] AS r
CREATE (n:Alternative) SET n = r;
UNWIND [{id: 'C1', label: '투자효율성', direction: 'Benefit', scale: '비율척도', scaleIri: 'RatioScale'}, {id: 'C2a', label: '특허창출규모', direction: 'Benefit', scale: '비율척도', scaleIri: 'RatioScale'}, {id: 'C2b', label: '기술이전율', direction: 'Benefit', scale: '비율척도', scaleIri: 'RatioScale'}, {id: 'C3', label: '사회적파급효과', direction: 'Benefit', scale: '등간척도', scaleIri: 'IntervalScale'}] AS r
CREATE (n:Criterion:BenefitCriterion) SET n = r;
UNWIND [{id: 'C2', label: '혁신역량'}] AS r
CREATE (n:Criterion) SET n = r;
UNWIND [{id: 'C4', label: '예산규모', direction: 'Cost', scale: '비율척도', scaleIri: 'RatioScale'}, {id: 'C5', label: '수행위험도', direction: 'Cost', scale: '등간척도', scaleIri: 'IntervalScale'}] AS r
CREATE (n:Criterion:CostCriterion) SET n = r;
