@prefix kosv:    <https://w3id.org/nrdp/kosv#> .
@prefix xkos:    <http://rdf-vocabulary.ddialliance.org/xkos#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#################################################################
#  분류체계 판(edition) 관리·대응표 모듈
#  v0.1.0 — 2026-10-10
#
#  도메인 독립 모듈. DDI-XKOS의 대응표 어휘(Correspondence,
#  ConceptAssociation, compares, madeOf, sourceConcept, targetConcept,
#  follows, supersedes, belongsTo)를 재사용하고, XKOS가 정의하지 않은
#  세 가지를 확장한다(XKOS 명세: "대응의 유형을 모델링하는 속성이나
#  하위 클래스는 현재 버전에서 정의하지 않는다").
#    (1) 변경 유형(명칭변경·통합·분할·통합 후 재분할·이동·동일)
#    (2) 대응의 근거(공식 고시 / 규칙 기반 도출 / 연구자 작성)와 검토 상태
#    (3) 개념의 생애(도입 판·종료 판)와 N:M 대응의 배분 비중
#
#  적용 대상: 국가과학기술표준분류(2018판↔2023판), 이후 예산 부문
#  코드·부처 코드 목록. 정책기술분류(중점과학기술→국가전략기술)는
#  공식 대응표가 없어 적용하지 않는다(D1 (c), 2026-10-12).
#  원칙: 원천 레코드의 분류값은 원래 판의 개념으로 보존하고, 판을 맞춘
#  값은 HarmonizationActivity 가 특정 Correspondence 를 사용해 생성한다.
#################################################################

<https://w3id.org/nrdp/kosv> a owl:Ontology ;
    dcterms:title "Classification edition and correspondence module"@en ,
                  "분류체계 판 관리·대응표 모듈"@ko ;
    dcterms:creator "최혜석" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionIRI <https://w3id.org/nrdp/kosv/0.1.1> ;
    owl:versionInfo "0.1.1" ;
    owl:priorVersion <https://w3id.org/nrdp/kosv/0.1.0> .

#################################################################
#  1. 판(edition)
#################################################################

kosv:ClassificationEdition a owl:Class ;
    rdfs:subClassOf skos:ConceptScheme ;
    rdfs:label "분류체계 판"@ko , "Classification edition"@en ;
    rdfs:comment "분류체계의 한 개정판. 유효기간은 연도 정수로 기록(xsd:gYear 는 OWL 2 datatype map 밖). XKOS 권고에 따라 dcterms:valid 를 주석으로 병기할 수 있다."@ko .

kosv:editionOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf xkos:belongsTo ;
    rdfs:label "소속 분류체계"@ko ;
    rdfs:domain kosv:ClassificationEdition ; rdfs:range kosv:Classification .

kosv:Classification a owl:Class ;
    rdfs:label "분류체계"@ko , "Classification"@en ;
    rdfs:comment "판을 묶는 분류체계 자체(예: 국가과학기술표준분류). XKOS는 이를 skos:Concept 로 모델링하도록 권고하나, 여기서는 판(ConceptScheme)과 구분되는 별도 클래스로 둔다."@ko .

kosv:validFromYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "적용 시작연도"@ko ;
    rdfs:domain kosv:ClassificationEdition ; rdfs:range xsd:integer ;
    rdfs:comment "이 판이 과제정보 입력에 적용되기 시작한 연도(고시 연도와 다를 수 있음)."@ko .
kosv:validToYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "적용 종료연도"@ko ;
    rdfs:domain kosv:ClassificationEdition ; rdfs:range xsd:integer .
kosv:announcedYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "고시(발표) 연도"@ko ;
    rdfs:domain kosv:ClassificationEdition ; rdfs:range xsd:integer .

xkos:follows a owl:ObjectProperty , owl:IrreflexiveProperty ;
    rdfs:label "계승"@ko ;
    rdfs:domain kosv:ClassificationEdition ; rdfs:range kosv:ClassificationEdition .
xkos:supersedes a owl:ObjectProperty ;
    rdfs:subPropertyOf xkos:follows ;
    rdfs:label "대체(이전 판 폐기)"@ko .
xkos:belongsTo a owl:ObjectProperty .

#################################################################
#  2. 개념의 생애
#################################################################

kosv:introducedIn a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "도입 판"@ko ;
    rdfs:domain skos:Concept ; rdfs:range kosv:ClassificationEdition ;
    rdfs:comment "대비표의 '신설' 항목. 이전 판에 원천 개념이 없다."@ko .
kosv:discontinuedIn a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "종료 판"@ko ;
    rdfs:domain skos:Concept ; rdfs:range kosv:ClassificationEdition ;
    rdfs:comment "후속 판에서 대상 개념이 없는 개념. 대비표의 '삭제' 표기는 실제로는 다른 중분류로의 이동·통합인 경우가 있으므로(예: 2018판 EE08·EE09 → 2023판 EE1207·EE1208), 검토 후에만 부여한다."@ko .

#################################################################
#  3. 대응표 (XKOS 재사용)
#################################################################

xkos:Correspondence a owl:Class ;
    rdfs:label "대응표"@ko , "Correspondence"@en ;
    rdfs:comment "두 판 사이의 개념 연관 집합."@ko ;
    rdfs:subClassOf
      [ a owl:Restriction ; owl:onProperty xkos:compares ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass skos:ConceptScheme ] ,
      [ a owl:Restriction ; owl:onProperty kosv:correspondenceBasis ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass kosv:CorrespondenceBasis ] .

xkos:ConceptAssociation a owl:Class ;
    rdfs:label "개념 연관"@ko , "Concept association"@en ;
    rdfs:comment "원천 개념 n개와 대상 개념 m개의 연관(n:m을 한 개체로 표현). 원천·대상 개수와 변경 유형의 정합성은 폐쇄세계 검사이므로 SHACL(kosv-shapes.ttl)로 위임한다."@ko ;
    rdfs:subClassOf
      [ a owl:Restriction ; owl:onProperty kosv:changeType ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass kosv:ChangeType ] .

xkos:compares a owl:ObjectProperty ;
    rdfs:label "비교 대상 판"@ko ;
    rdfs:domain xkos:Correspondence ; rdfs:range skos:ConceptScheme .
xkos:madeOf a owl:ObjectProperty ;
    rdfs:label "구성 연관"@ko ;
    rdfs:domain xkos:Correspondence ; rdfs:range xkos:ConceptAssociation .
xkos:sourceConcept a owl:ObjectProperty ;
    rdfs:label "원천 개념"@ko ;
    rdfs:domain xkos:ConceptAssociation ; rdfs:range skos:Concept .
xkos:targetConcept a owl:ObjectProperty ;
    rdfs:label "대상 개념"@ko ;
    rdfs:domain xkos:ConceptAssociation ; rdfs:range skos:Concept .

kosv:sourceEdition a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf xkos:compares ;
    rdfs:label "이전 판"@ko ;
    rdfs:domain xkos:Correspondence ; rdfs:range kosv:ClassificationEdition .
kosv:targetEdition a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf xkos:compares ;
    rdfs:label "이후 판"@ko ;
    rdfs:domain xkos:Correspondence ; rdfs:range kosv:ClassificationEdition .

#################################################################
#  4. 변경 유형 (XKOS 확장)
#################################################################

kosv:ChangeType a owl:Class ;
    rdfs:label "변경 유형"@ko , "Change type"@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf (
        kosv:Identity kosv:Rename kosv:Merge kosv:Split kosv:MergeResplit kosv:Relocation ) ] .

kosv:Identity     a owl:NamedIndividual , kosv:ChangeType ;
    rdfs:label "동일"@ko ; rdfs:comment "코드·명칭 동일. 1:1."@ko .
kosv:Rename       a owl:NamedIndividual , kosv:ChangeType ;
    rdfs:label "명칭변경"@ko ; rdfs:comment "코드 유지·명칭 변경. 1:1. 의미 범위 변화 여부는 해설서 대조로 별도 판단."@ko .
kosv:Merge        a owl:NamedIndividual , kosv:ChangeType ;
    rdfs:label "통합"@ko ; rdfs:comment "N:1."@ko .
kosv:Split        a owl:NamedIndividual , kosv:ChangeType ;
    rdfs:label "분할"@ko ; rdfs:comment "1:N. 집계 시 배분 규칙 필요."@ko .
kosv:MergeResplit a owl:NamedIndividual , kosv:ChangeType ;
    rdfs:label "통합 후 재분할"@ko ; rdfs:comment "N:M. 집계 시 배분 규칙 필요."@ko .
kosv:Relocation   a owl:NamedIndividual , kosv:ChangeType ;
    rdfs:label "이동"@ko ; rdfs:comment "다른 중분류로 이동하며 코드 변경. 1:1 또는 통합과 결합."@ko .
[] a owl:AllDifferent ; owl:distinctMembers (
    kosv:Identity kosv:Rename kosv:Merge kosv:Split kosv:MergeResplit kosv:Relocation ) .

kosv:changeType a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "변경 유형"@ko ;
    rdfs:domain xkos:ConceptAssociation ; rdfs:range kosv:ChangeType .
kosv:alsoRelocated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "이동 동반"@ko ;
    rdfs:domain xkos:ConceptAssociation ; rdfs:range xsd:boolean ;
    rdfs:comment "통합·분할이 중분류 이동을 동반하는 경우(대비표 '통합, 이동')."@ko .

#################################################################
#  5. 대응의 근거·검토 상태
#################################################################

kosv:CorrespondenceBasis a owl:Class ;
    rdfs:label "대응 근거"@ko , "Correspondence basis"@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf (
        kosv:OfficialTable kosv:RuleDerived kosv:ResearcherAuthored kosv:DataDerived ) ] .
kosv:OfficialTable      a owl:NamedIndividual , kosv:CorrespondenceBasis ;
    rdfs:label "공식 대비표"@ko ; rdfs:comment "고시 문서의 신구 대비표에서 추출."@ko .
kosv:RuleDerived        a owl:NamedIndividual , kosv:CorrespondenceBasis ;
    rdfs:label "규칙 도출"@ko ; rdfs:comment "명시적 규칙에서 도출(예: 대비표에 수록되지 않은 중분류는 코드 동일 개념끼리 1:1)."@ko .
kosv:ResearcherAuthored a owl:NamedIndividual , kosv:CorrespondenceBasis ;
    rdfs:label "연구자 작성"@ko ; rdfs:comment "공식 대응표가 없는 경우. 연관마다 근거 문서·위치(sourceDocument)와 판정 사유를 기록하여, 판정자 합의 대신 기록 대조로 검토한다."@ko .
kosv:DataDerived        a owl:NamedIndividual , kosv:CorrespondenceBasis ;
    rdfs:label "데이터 도출"@ko ; rdfs:comment "동일 과제의 이중 코딩(구·신 분류 병기) 빈도에서 추정."@ko .
[] a owl:AllDifferent ; owl:distinctMembers (
    kosv:OfficialTable kosv:RuleDerived kosv:ResearcherAuthored kosv:DataDerived ) .

kosv:correspondenceBasis a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "대응 근거"@ko ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( xkos:Correspondence xkos:ConceptAssociation ) ] ;
    rdfs:range kosv:CorrespondenceBasis ;
    rdfs:comment "대응표 단위로 부여하되, 같은 대응표 안에서 근거가 다른 연관(공식 대비표 + 규칙 도출)은 연관 단위로 덮어쓴다."@ko .

kosv:reviewStatus a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "검토 상태"@ko ;
    rdfs:domain xkos:ConceptAssociation ; rdfs:range skos:Concept ;
    rdfs:comment "자동 추출 → 수작업 검토 → 근거 재대조(재검토)의 단계. 재검토에서 바뀐 판정은 변경 전후를 함께 기록한다. 값은 ReviewStatus 체계(kosv-schemes, 미작성)."@ko .

kosv:sourceDocument a owl:DatatypeProperty ;
    rdfs:label "근거 문서"@ko ;
    rdfs:domain xkos:Correspondence ; rdfs:range xsd:string .
kosv:sourceLocator a owl:DatatypeProperty ;
    rdfs:label "근거 위치"@ko ;
    rdfs:domain xkos:ConceptAssociation ; rdfs:range xsd:string ;
    rdfs:comment "근거 문서 내 위치(쪽·행). 감사 추적용."@ko .

#################################################################
#  6. N:M 배분 비중
#################################################################

kosv:AllocationShare a owl:Class ;
    rdfs:label "배분 비중"@ko , "Allocation share"@en ;
    rdfs:comment "분할·통합 후 재분할 연관에서 (원천, 대상) 쌍별 배분 비중. 집계값이 이 비중에 의존하므로 근거를 함께 기록한다. 같은 원천의 비중 합 = 1 은 SHACL로 검사."@ko ;
    rdfs:subClassOf
      [ a owl:Restriction ; owl:onProperty kosv:shareOf ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass xkos:ConceptAssociation ] ,
      [ a owl:Restriction ; owl:onProperty kosv:fromConcept ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass skos:Concept ] ,
      [ a owl:Restriction ; owl:onProperty kosv:toConcept ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass skos:Concept ] .
kosv:shareOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain kosv:AllocationShare ; rdfs:range xkos:ConceptAssociation .
kosv:fromConcept a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain kosv:AllocationShare ; rdfs:range skos:Concept .
kosv:toConcept a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain kosv:AllocationShare ; rdfs:range skos:Concept .
kosv:shareValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "비중"@ko ;
    rdfs:domain kosv:AllocationShare ;
    rdfs:range [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ;
        owl:withRestrictions ( [ xsd:minInclusive "0"^^xsd:decimal ] [ xsd:maxInclusive "1"^^xsd:decimal ] ) ] .

#################################################################
#  7. 판 맞춤(harmonization) 활동
#################################################################

kosv:HarmonizationActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "판 맞춤"@ko , "Harmonization run"@en ;
    rdfs:comment "원래 판의 분류값을 특정 대응표(prov:used)로 다른 판에 맞춘 값을 생성하는 활동. 생성된 값은 prov:wasDerivedFrom 으로 원래 값을 가리킨다. 원래 값은 덮어쓰지 않는다."@ko ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty prov:used ;
        owl:someValuesFrom xkos:Correspondence ] .

#################################################################
#  외부 어휘 선언
#################################################################
skos:Concept a owl:Class . skos:ConceptScheme a owl:Class . prov:Activity a owl:Class .
prov:used a owl:ObjectProperty .
dcterms:title a owl:AnnotationProperty . dcterms:creator a owl:AnnotationProperty . dcterms:license a owl:AnnotationProperty .

#  v0.1.1 (2026-10-20) OOPS! P08 레이블 보완. 공리 변경 없음
kosv:shareOf rdfs:label "배분 대상 연관"@ko .
kosv:fromConcept rdfs:label "배분 원천 개념"@ko .
kosv:toConcept rdfs:label "배분 대상 개념"@ko .
