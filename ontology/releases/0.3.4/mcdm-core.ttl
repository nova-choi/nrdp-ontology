@prefix mcdm:    <https://w3id.org/nrdp/mcdm#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#################################################################
#  MCDM 표현 계층 (Layer 2) + 설명 계층 중 기법 공통부 (Layer 3 일부)
#  v0.3.0 — 2026-10-10 / v0.3.2 — 2026-10-19 (실데이터 검증 반영: 정규화값 범위 공리를 SHACL로 이관,
#           정규화방법의 허용 하한·상한 속성 추가, CompensatoryMethod 라벨을 '보상 허용 기법'으로)
#  v0.3.3 — 2026-10-20 (OOPS! P08 레이블 보완. 공리 변경 없음)
#
#  모듈 분리 원칙: 이 파일은 도메인 계층(nrdp:)의 어떤 IRI도 참조하지 않는다.
#  도메인 계층이 이 파일을 owl:imports 하며, 의존 방향은 nrdp → mcdm 한 방향이다.
#  (v0.2의 mcdm:measuredBy → nrdp:PerformanceIndicator,
#   mcdm:reflectsPolicyGoal → nrdp:PolicyGoal 두 곳의 역방향 의존을 제거)
#################################################################

<https://w3id.org/nrdp/mcdm> a owl:Ontology ;
    dcterms:title "Method-agnostic MCDM representation layer"@en ,
                  "방법 중립적 MCDM 표현 계층"@ko ;
    dcterms:creator "최혜석" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionIRI <https://w3id.org/nrdp/mcdm/0.3.4> ;
    owl:versionInfo "0.3.4" ;
    owl:priorVersion <https://w3id.org/nrdp/mcdm/0.3.3> ;
    rdfs:comment "v0.3: 도메인 독립 모듈로 분리. 기준 방향 공리를 리프 기준으로 한정, 집계기법을 집계 논리(가치함수·거리·열위관계)와 보상 수준의 두 축으로 분해, PROV-O 정렬 선언."@ko .

#################################################################
#  1. 의사결정 문제·대안
#################################################################

mcdm:DecisionProblem a owl:Class ;
    rdfs:label "의사결정문제"@ko , "Decision problem"@en ;
    rdfs:comment "대안 집합과 기준 집합을 묶는 하나의 평가 과업."@ko .

mcdm:Alternative a owl:Class ;
    rdfs:label "대안"@ko , "Alternative"@en ;
    rdfs:comment "평가 대상이 특정 의사결정 문제 안에서 맡는 역할(Agent-Role ODP). 도메인 개체와 동일시하지 않는다."@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty mcdm:inProblem ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass mcdm:DecisionProblem ] .

mcdm:hasAlternative a owl:ObjectProperty ;
    rdfs:label "대안 보유"@ko ;
    rdfs:domain mcdm:DecisionProblem ; rdfs:range mcdm:Alternative ;
    owl:inverseOf mcdm:inProblem .

mcdm:inProblem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "소속 의사결정문제"@ko ;
    rdfs:domain mcdm:Alternative ; rdfs:range mcdm:DecisionProblem .

mcdm:representsEntity a owl:ObjectProperty ;
    rdfs:label "표상 개체"@ko ;
    rdfs:domain mcdm:Alternative ;
    rdfs:comment "대안이 표상하는 도메인 개체. 레인지를 두지 않는 것이 계층 독립의 조건이다."@ko .

mcdm:hasCriterion a owl:ObjectProperty ;
    rdfs:label "기준 보유"@ko ;
    rdfs:domain mcdm:DecisionProblem ; rdfs:range mcdm:Criterion .

#################################################################
#  2. 기준 — 방향은 리프 기준에만 (T2·T3 해소)
#################################################################

mcdm:Criterion a owl:Class ;
    rdfs:label "평가기준"@ko , "Criterion"@en .

mcdm:LeafCriterion a owl:Class ;
    rdfs:subClassOf mcdm:Criterion ;
    owl:disjointWith mcdm:CompositeCriterion ;
    rdfs:label "리프 기준"@ko , "Leaf criterion"@en ;
    rdfs:comment "평가값이 직접 부여되는 기준. 최적화 방향을 정확히 하나 가진다."@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty mcdm:hasDirection ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass mcdm:OptimizationDirection ] ;
    owl:equivalentClass [ a owl:Class ;
        owl:unionOf ( mcdm:BenefitCriterion mcdm:CostCriterion ) ] .

mcdm:CompositeCriterion a owl:Class ;
    rdfs:subClassOf mcdm:Criterion ;
    rdfs:label "상위 기준"@ko , "Composite criterion"@en ;
    rdfs:comment "하위기준을 묶는 상위 기준. 방향을 갖지 않는다(v0.2의 '혁신역량' 문제 해소)."@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty mcdm:hasSubCriterion ;
        owl:someValuesFrom mcdm:Criterion ] ,
      [ a owl:Restriction ;
        owl:onProperty mcdm:hasDirection ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger ] .

mcdm:BenefitCriterion a owl:Class ;
    rdfs:label "편익형 기준"@ko , "Benefit criterion"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( mcdm:Criterion
            [ a owl:Restriction ; owl:onProperty mcdm:hasDirection ; owl:hasValue mcdm:Benefit ] ) ] .

mcdm:CostCriterion a owl:Class ;
    rdfs:label "비용형 기준"@ko , "Cost criterion"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( mcdm:Criterion
            [ a owl:Restriction ; owl:onProperty mcdm:hasDirection ; owl:hasValue mcdm:Cost ] ) ] .

mcdm:OptimizationDirection a owl:Class ;
    rdfs:label "최적화방향"@ko , "Optimization direction"@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( mcdm:Benefit mcdm:Cost ) ] .

mcdm:Benefit a owl:NamedIndividual , mcdm:OptimizationDirection ;
    rdfs:label "편익(최대화)"@ko , "Benefit (maximise)"@en .
mcdm:Cost a owl:NamedIndividual , mcdm:OptimizationDirection ;
    rdfs:label "비용(최소화)"@ko , "Cost (minimise)"@en .
[] a owl:AllDifferent ; owl:distinctMembers ( mcdm:Benefit mcdm:Cost ) .

mcdm:MeasurementScale a owl:Class ;
    rdfs:label "측정척도"@ko , "Measurement scale"@en .
mcdm:RatioScale    a owl:NamedIndividual , mcdm:MeasurementScale ; rdfs:label "비율척도"@ko .
mcdm:IntervalScale a owl:NamedIndividual , mcdm:MeasurementScale ; rdfs:label "등간척도"@ko .
mcdm:OrdinalScale  a owl:NamedIndividual , mcdm:MeasurementScale ; rdfs:label "순서척도"@ko .
[] a owl:AllDifferent ; owl:distinctMembers ( mcdm:RatioScale mcdm:IntervalScale mcdm:OrdinalScale ) .

mcdm:hasSubCriterion a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:label "하위기준"@ko ;
    rdfs:domain mcdm:CompositeCriterion ; rdfs:range mcdm:Criterion ;
    rdfs:comment "T1: 추이적 선언을 제거하고 비반사·비대칭(단순 역할)으로 선언. 계층 전체 탐색은 질의의 전이 폐쇄(SPARQL hasSubCriterion+, Cypher *1..)로 처리한다. OWL 2 DL은 추이적(비단순) 속성에 비반사·비대칭 공리를 허용하지 않으므로 둘 중 하나를 택해야 하며, 순환 계층 방지가 더 근본적이라 판단했다."@ko .

mcdm:hasDirection a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "최적화방향"@ko ;
    rdfs:domain mcdm:Criterion ; rdfs:range mcdm:OptimizationDirection .

mcdm:hasScale a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "측정척도"@ko ;
    rdfs:domain mcdm:LeafCriterion ; rdfs:range mcdm:MeasurementScale .

#################################################################
#  3. 지표 — 도메인 지표가 하위클래스로 들어오는 접속점 (T10 해소)
#################################################################

mcdm:Indicator a owl:Class ;
    rdfs:label "측정지표"@ko , "Indicator"@en ;
    rdfs:comment "기준을 측정하는 지표의 추상 클래스. 도메인 계층의 지표 클래스가 이 클래스의 하위클래스로 선언된다."@ko .

mcdm:measuredBy a owl:ObjectProperty ;
    rdfs:label "측정지표"@ko ;
    rdfs:domain mcdm:LeafCriterion ; rdfs:range mcdm:Indicator .

#################################################################
#  4. 평가값·정규화값 (n-ary 재화)
#################################################################

mcdm:CriterionValue a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "평가값"@ko , "Criterion value"@en ;
    rdfs:comment "대안×리프기준의 원시 평가값. prov:wasDerivedFrom 으로 도메인 관측치에 연결된다."@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty mcdm:ofAlternative ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass mcdm:Alternative ] ,
      [ a owl:Restriction ;
        owl:onProperty mcdm:onCriterion ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass mcdm:LeafCriterion ] .

mcdm:NormalizedValue a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "정규화값"@ko , "Normalized value"@en ;
    rdfs:comment "평가값×정규화방법의 재화(v0.2). prov:wasGeneratedBy 는 NormalizationActivity 여야 한다(T7: v0.2 데이터에서 원시값에 걸려 있던 생성 관계를 이쪽으로 이동)."@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty mcdm:ofCriterionValue ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass mcdm:CriterionValue ] ,
      [ a owl:Restriction ;
        owl:onProperty mcdm:normalizedBy ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass mcdm:NormalizationMethod ] .

mcdm:ofAlternative a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "대상 대안"@ko ;
    rdfs:domain mcdm:CriterionValue ; rdfs:range mcdm:Alternative .
mcdm:onCriterion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "대상 기준"@ko ;
    rdfs:domain mcdm:CriterionValue ; rdfs:range mcdm:LeafCriterion .

mcdm:hasNormalization a owl:ObjectProperty ;
    rdfs:label "정규화값 보유"@ko ;
    rdfs:domain mcdm:CriterionValue ; rdfs:range mcdm:NormalizedValue .
mcdm:ofCriterionValue a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "원평가값"@ko ;
    rdfs:domain mcdm:NormalizedValue ; rdfs:range mcdm:CriterionValue ;
    owl:inverseOf mcdm:hasNormalization .
mcdm:normalizedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "정규화방법"@ko ;
    rdfs:domain mcdm:NormalizedValue ; rdfs:range mcdm:NormalizationMethod .

mcdm:hasRawValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "원시값"@ko ;
    rdfs:domain mcdm:CriterionValue ; rdfs:range xsd:decimal .
mcdm:hasUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "단위"@ko ;
    rdfs:domain mcdm:CriterionValue ; rdfs:range xsd:string .
mcdm:hasValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "정규화값(수치)"@ko ;
    rdfs:domain mcdm:NormalizedValue ;
    rdfs:comment "v0.3.2: v0.3.0의 [0,1] 데이터타입 제한을 해제하였다. 벡터 정규화·z-score 등은 원시값의 부호에 따라 [0,1] 밖의 값을 내므로, 허용 범위는 정규화방법 개체의 normalizedLowerBound·normalizedUpperBound 로 기록하고 SHACL(mcdm-shapes.ttl M6)로 검사한다. 정규화방법을 데이터 계층 개체로 열어 두기 위한 설계 선택이며, 정규화방법을 스키마의 명명 개체로 둔다면 OWL 2 DL의 hasValue 제한과 데이터 범위 제한으로도 표현할 수 있다."@ko ;
    rdfs:range xsd:decimal .

mcdm:hasNormalizedValue a owl:DatatypeProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:label "정규화값(v0.1, 폐기)"@ko ;
    rdfs:comment "v0.1 전용. v0.2부터 NormalizedValue 패턴으로 대체."@ko .

#################################################################
#  5. 시나리오·가중치
#################################################################

mcdm:DecisionScenario a owl:Class ;
    rdfs:label "의사결정 시나리오"@ko , "Decision scenario"@en ;
    rdfs:comment "하나의 정책 선호 = 하나의 가중치 집합."@ko .

mcdm:Weight a owl:Class ;
    rdfs:label "가중치"@ko , "Weight"@en ;
    rdfs:comment "기준의 고유 속성이 아니라 시나리오에 종속되는 개체. 시나리오 내 가중치 합 = 1은 SHACL-SPARQL로 위임."@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty mcdm:assignedToCriterion ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass mcdm:Criterion ] .

mcdm:hasWeight a owl:ObjectProperty ;
    rdfs:label "가중치 보유"@ko ;
    rdfs:domain mcdm:DecisionScenario ; rdfs:range mcdm:Weight .
mcdm:assignedToCriterion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "적용 기준"@ko ;
    rdfs:domain mcdm:Weight ; rdfs:range mcdm:Criterion .
mcdm:hasWeightValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "가중치 값"@ko ;
    rdfs:domain mcdm:Weight ;
    rdfs:range [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ;
        owl:withRestrictions ( [ xsd:minInclusive "0"^^xsd:decimal ] [ xsd:maxInclusive "1"^^xsd:decimal ] ) ] .
mcdm:derivedFrom a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:label "가중치 도출 근거"@ko ;
    rdfs:domain mcdm:Weight .

mcdm:reflectsPolicyObjective a owl:ObjectProperty ;
    rdfs:label "반영 정책목표"@ko ;
    rdfs:domain mcdm:DecisionScenario ; rdfs:range skos:Concept ;
    rdfs:comment "v0.2의 mcdm:reflectsPolicyGoal(레인지 nrdp:PolicyGoal)을 대체. 레인지를 skos:Concept로 두어 도메인 의존 제거(T11)."@ko .

mcdm:scenarioLabel a owl:DatatypeProperty ;
    rdfs:domain mcdm:DecisionScenario ; rdfs:range xsd:string .

#################################################################
#  6. 집계기법 — 집계 논리(3계열) × 보상 수준 (T4·T5 해소)
#################################################################

mcdm:AggregationMethod a owl:Class ;
    rdfs:label "집계기법"@ko , "Aggregation method"@en .

mcdm:ValueFunctionMethod a owl:Class ;
    rdfs:subClassOf mcdm:AggregationMethod ;
    rdfs:label "가치함수형 기법"@ko , "Value-function method"@en ;
    rdfs:comment "WSM 등 가법 가치함수 기반."@ko .
mcdm:DistanceBasedMethod a owl:Class ;
    rdfs:subClassOf mcdm:AggregationMethod ;
    rdfs:label "거리기반 기법"@ko , "Distance-based method"@en ;
    rdfs:comment "TOPSIS 등 기준점과의 거리 기반."@ko .
mcdm:OutrankingMethod a owl:Class ;
    rdfs:subClassOf mcdm:AggregationMethod ;
    rdfs:label "아웃랭킹형 기법"@ko , "Outranking method"@en ;
    rdfs:comment "PROMETHEE·ELECTRE 등 쌍대 선호관계 기반."@ko .
[] a owl:AllDisjointClasses ;
   owl:members ( mcdm:ValueFunctionMethod mcdm:DistanceBasedMethod mcdm:OutrankingMethod ) .

mcdm:CompensationLevel a owl:Class ;
    rdfs:label "보상 수준"@ko , "Compensation level"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( mcdm:FullCompensation mcdm:PartialCompensation mcdm:NonCompensation ) ] .
mcdm:FullCompensation    a owl:NamedIndividual , mcdm:CompensationLevel ; rdfs:label "완전보상"@ko .
mcdm:PartialCompensation a owl:NamedIndividual , mcdm:CompensationLevel ; rdfs:label "부분보상"@ko .
mcdm:NonCompensation     a owl:NamedIndividual , mcdm:CompensationLevel ; rdfs:label "비보상"@ko .
[] a owl:AllDifferent ;
   owl:distinctMembers ( mcdm:FullCompensation mcdm:PartialCompensation mcdm:NonCompensation ) .

mcdm:hasCompensationLevel a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "보상 수준"@ko ;
    rdfs:domain mcdm:AggregationMethod ; rdfs:range mcdm:CompensationLevel .

mcdm:CompensatoryMethod a owl:Class ;
    rdfs:label "보상 허용 기법"@ko , "Compensation-admitting method"@en ;
    rdfs:comment "정의 클래스. 보상 수준이 완전 또는 부분인 기법으로 추론된다. 집계 논리 3계열과 직교하는 분류 축이다. 보상 수준은 기법 개체(파라미터를 포함한 구성)에 기록하므로, 선형 선호함수를 쓰는 PROMETHEE II처럼 아웃랭킹 논리이면서 부분 보상인 기법도 이 클래스에 속한다. v0.3.2에서 라벨을 '보상형 기법'에서 '보상 허용 기법'으로 변경."@ko ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( mcdm:AggregationMethod
            [ a owl:Restriction ; owl:onProperty mcdm:hasCompensationLevel ;
              owl:someValuesFrom [ a owl:Class ;
                  owl:oneOf ( mcdm:FullCompensation mcdm:PartialCompensation ) ] ] ) ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty mcdm:requiresNormalization ;
        owl:hasValue "true"^^xsd:boolean ] .

mcdm:NonCompensatoryMethod a owl:Class ;
    rdfs:label "비보상형 기법"@ko , "Non-compensatory method"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( mcdm:AggregationMethod
            [ a owl:Restriction ; owl:onProperty mcdm:hasCompensationLevel ;
              owl:hasValue mcdm:NonCompensation ] ) ] .

mcdm:requiresNormalization a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "정규화 필요"@ko ;
    rdfs:domain mcdm:AggregationMethod ; rdfs:range xsd:boolean .
mcdm:supportsAdditiveDecomposition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "가법 분해 가능"@ko ;
    rdfs:domain mcdm:AggregationMethod ; rdfs:range xsd:boolean ;
    rdfs:comment "종합점수를 기준별 기여의 합으로 분해할 수 있는가. WSM·PROMETHEE II(단일기준 순흐름)는 true, TOPSIS는 false. CriterionContribution 은 이 값이 true인 기법의 결과에만 허용(SHACL)."@ko .
mcdm:hasPreferenceModel a owl:DatatypeProperty ;
    rdfs:domain mcdm:AggregationMethod ; rdfs:range xsd:string .

mcdm:PreferenceFunction a owl:Class ;
    rdfs:label "선호함수"@ko , "Preference function"@en .
mcdm:NormalizationMethod a owl:Class ;
    rdfs:label "정규화방법"@ko , "Normalization method"@en .
mcdm:normalizedLowerBound a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "정규화값 허용 하한"@ko , "normalized value lower bound"@en ;
    rdfs:comment "이 방법이 산출하는 정규화값의 허용 하한. 없으면 하한을 검사하지 않는다(SHACL M6)."@ko ;
    rdfs:domain mcdm:NormalizationMethod ; rdfs:range xsd:decimal .
mcdm:normalizedUpperBound a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "정규화값 허용 상한"@ko , "normalized value upper bound"@en ;
    rdfs:comment "이 방법이 산출하는 정규화값의 허용 상한. 없으면 상한을 검사하지 않는다(SHACL M6)."@ko ;
    rdfs:domain mcdm:NormalizationMethod ; rdfs:range xsd:decimal .

mcdm:usesPreferenceFunction a owl:ObjectProperty ;
    rdfs:domain mcdm:AggregationMethod ; rdfs:range mcdm:PreferenceFunction .
mcdm:usesNormalization a owl:ObjectProperty ;
    rdfs:domain mcdm:AggregationMethod ; rdfs:range mcdm:NormalizationMethod .
mcdm:preferenceThresholdQ a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "무차별 임계값 q"@ko ;
    rdfs:domain mcdm:PreferenceFunction ; rdfs:range xsd:decimal .
mcdm:preferenceThresholdP a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "선호 임계값 p"@ko ;
    rdfs:domain mcdm:PreferenceFunction ; rdfs:range xsd:decimal .

#################################################################
#  7. 평가결과·설명
#################################################################

mcdm:DecisionResult a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "평가결과"@ko , "Decision result"@en ;
    rdfs:comment "(문제, 시나리오, 기법, 대안) 조합의 산출. 한 (시나리오, 기법) 안의 순위가 1..n 순열이라는 제약은 SHACL-SPARQL로 위임."@ko ;
    rdfs:subClassOf
      [ a owl:Restriction ; owl:onProperty mcdm:forProblem ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass mcdm:DecisionProblem ] ,
      [ a owl:Restriction ; owl:onProperty mcdm:forScenario ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass mcdm:DecisionScenario ] ,
      [ a owl:Restriction ; owl:onProperty mcdm:byMethod ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass mcdm:AggregationMethod ] ,
      [ a owl:Restriction ; owl:onProperty mcdm:forAlternative ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass mcdm:Alternative ] .

mcdm:forProblem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain mcdm:DecisionResult ; rdfs:range mcdm:DecisionProblem .
mcdm:forScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain mcdm:DecisionResult ; rdfs:range mcdm:DecisionScenario .
mcdm:byMethod a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain mcdm:DecisionResult ; rdfs:range mcdm:AggregationMethod .
mcdm:forAlternative a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "대상 대안"@ko ;
    rdfs:domain mcdm:DecisionResult ; rdfs:range mcdm:Alternative .

mcdm:hasScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain mcdm:DecisionResult ; rdfs:range xsd:decimal .
mcdm:hasRank a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain mcdm:DecisionResult ;
    rdfs:range [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
        owl:withRestrictions ( [ xsd:minInclusive "1"^^xsd:integer ] ) ] .

mcdm:EvaluationActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "평가 실행"@ko , "Evaluation run"@en ;
    rdfs:comment "한 (시나리오, 기법) 조합의 계산 실행. DecisionResult 는 이 활동으로 생성된다."@ko .
mcdm:NormalizationActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "정규화 수행"@ko , "Normalization run"@en .

mcdm:Explanation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "설명"@ko , "Explanation"@en .
mcdm:CriterionContribution a owl:Class ;
    rdfs:subClassOf mcdm:Explanation ;
    rdfs:label "기준별 기여도"@ko .
mcdm:EvidencePath a owl:Class ;
    rdfs:subClassOf mcdm:Explanation ;
    rdfs:label "근거경로"@ko .
mcdm:CounterfactualCondition a owl:Class ;
    rdfs:subClassOf mcdm:Explanation ;
    rdfs:label "반사실적 설명"@ko , "Counterfactual explanation"@en ;
    rdfs:comment "목표 결과(예: 순위 진입)에 필요한 기준별 입력 변화. 본문 용어 '반사실적 설명'에 맞춰 v0.3.2에서 라벨 변경."@ko .
[] a owl:AllDisjointClasses ;
   owl:members ( mcdm:CriterionContribution mcdm:EvidencePath mcdm:CounterfactualCondition ) .

mcdm:explains a owl:ObjectProperty ;
    rdfs:domain mcdm:Explanation ; rdfs:range mcdm:DecisionResult .
mcdm:contributionOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain mcdm:CriterionContribution ; rdfs:range mcdm:Criterion .
mcdm:hasContributionRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain mcdm:CriterionContribution ; rdfs:range xsd:decimal ;
    rdfs:comment "기준의 기여값을 종합점수로 나눈 비율. 종합점수가 양수인 결과에서만 해석할 수 있다(v0.3.4 주석 추가)."@ko .
mcdm:hasContributionValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "기여값"@ko , "contribution value"@en ;
    rdfs:domain mcdm:CriterionContribution ; rdfs:range xsd:decimal ;
    rdfs:comment "종합점수 가운데 해당 기준의 몫. 한 결과의 기준별 기여값을 모두 더하면 종합점수와 같다(SHACL M7). WSM은 w_j·r_ij, PROMETHEE II는 w_j·φ_j(a). v0.3.4 추가: 순흐름이 0 이하인 결과에서는 기여비율이 정의되지 않으므로 절대값으로 기록한다."@ko .
mcdm:isFeasible a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "실현가능성"@ko ;
    rdfs:domain mcdm:CounterfactualCondition ; rdfs:range xsd:boolean .
mcdm:concernsCriterion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "개선 대상 기준"@ko , "concerns criterion"@en ;
    rdfs:domain mcdm:CounterfactualCondition ; rdfs:range mcdm:Criterion .
mcdm:requiredNormalizedValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "필요 정규화값"@ko , "required normalized value"@en ;
    rdfs:comment "목표 순위 진입에 필요한 해당 기준의 정규화값. 1.0을 넘으면 관측 범위 밖이므로 isFeasible=false. 정규화값과 같은 범위 검사(SHACL M6)는 적용하지 않는다."@ko ;
    rdfs:domain mcdm:CounterfactualCondition ; rdfs:range xsd:decimal .
mcdm:requiredRawValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "필요 원시값"@ko , "required raw value"@en ;
    rdfs:domain mcdm:CounterfactualCondition ; rdfs:range xsd:decimal .
mcdm:requiredWeightValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "필요 가중치"@ko , "required weight value"@en ;
    rdfs:domain mcdm:CounterfactualCondition ; rdfs:range xsd:decimal ;
    rdfs:comment "목표 결과(예: 두 대안의 순위 역전)에 필요한 해당 기준의 조정 후 가중치. 나머지 기준의 가중치는 합이 1이 되도록 비례 재조정한다고 가정한다. 순위 역전 조건은 두 대안의 결과를 모두 mcdm:explains 로 가리킨다. v0.3.4 추가(CQ25)."@ko .
#  반사실적 설명 전용 속성 (2026-10-10): v0.2 샘플은 CounterfactualCondition 에 contributionOf·
#  hasContributionRatio(도메인 CriterionContribution)와 hasRawValue(도메인 CriterionValue)를 재사용하여,
#  추론 시 반사실적 설명이 기여 분해·평가값으로도 분류되었다(일관성 검사는 통과).
#  아래 배타 공리를 함께 두어 같은 오용이 재발하면 비일관으로 드러나게 한다.
mcdm:CriterionValue owl:disjointWith mcdm:Explanation .

#################################################################
#  OWL 2 DL로 표현하지 않고 SHACL로 위임하는 제약 (mcdm-shapes.ttl M1~M5, 2026-10-19 작성)
#   M1 한 DecisionScenario 의 hasWeightValue 합 = 1          (산술 합)
#   M2 한 (Problem, Scenario, Method) 안 hasRank 가 1..n 순열  (집계·유일성)
#   M3 CriterionContribution 은 supportsAdditiveDecomposition=true 기법의 결과에만
#   M4 (CriterionValue, NormalizationMethod) 쌍당 NormalizedValue 1개 (복합 키)
#   M5 문제의 모든 (대안, 리프기준) 쌍에 CriterionValue 존재 — 결측 탐지(경고 수준)
#   M6 NormalizedValue.hasValue 가 그 정규화방법의 허용 하한·상한 안 (v0.3.2, OWL 범위 제한에서 이관)
#################################################################

#################################################################
#  외부 어휘 선언 (DL 프로파일 검사·추론기 입력용 punning 방지)
#################################################################
prov:Entity a owl:Class . prov:Activity a owl:Class . skos:Concept a owl:Class .
prov:wasDerivedFrom a owl:ObjectProperty .
dcterms:title a owl:AnnotationProperty . dcterms:creator a owl:AnnotationProperty . dcterms:license a owl:AnnotationProperty .

#  v0.3.3 (2026-10-20) OOPS! P08 레이블 보완
mcdm:forProblem rdfs:label "대상 의사결정문제"@ko .
mcdm:forScenario rdfs:label "적용 시나리오"@ko .
mcdm:byMethod rdfs:label "적용 기법"@ko .
mcdm:hasScore rdfs:label "점수"@ko .
mcdm:hasRank rdfs:label "순위"@ko .
mcdm:explains rdfs:label "설명 대상 결과"@ko .
mcdm:contributionOf rdfs:label "기여 기준"@ko .
mcdm:hasContributionRatio rdfs:label "기여비율"@ko .
mcdm:usesPreferenceFunction rdfs:label "사용 선호함수"@ko .
mcdm:usesNormalization rdfs:label "사용 정규화방법"@ko .
mcdm:hasPreferenceModel rdfs:label "선호 모형"@ko .
mcdm:scenarioLabel rdfs:label "시나리오 설명"@ko .
